---
import Layout from "../layouts/Layout.astro"
import Navbar from "../components/core/Navbar.astro"
import SecondaryNavbar from "../components/core/SecondaryNavbar.astro"
import Map from "../components/Map.astro"
import Proplist from "../components/Proplist.astro"
import Filters from "../components/subComponents/navbarElements/Filters.astro"
---

<Layout title="Real Estate">
    <Navbar />
    <SecondaryNavbar />
    <Filters/>
    <div class="grid grid-cols-2 gap-0 h-screen static">
        <Map />
        <Proplist />
    </div>
</Layout>



  


