---

import Layout from "../../layouts/Layout.astro";
import listings from "../../content/propertyListings";

export async function getStaticPaths() {
  return listings.map((listing) => ({
    params: { slug: listing.slug },
    props: listing
  }));
}

const property = Astro.props;

---


<Layout title={`${property.location.address} - ${property.location.city}`}>
  <h1>{property.price}</h1>
  <p>{property.description}</p>
  <p> Ubicación: {property.location.address}, {property.location.city}, {property.location.state}</p>
  <img src={property.media[0]} alt="Imagen principal" />
</Layout>



