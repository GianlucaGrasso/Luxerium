---

const Price = "$999,999,999";
const Extra = " $12,500 " + " per month";
const { Title } = Astro.props;
const Location = {
  Country: "Argentina",
  State: "Buenos Aires",
  City: "Lomas de Zamora",
  Address: "249 Avenida Hipólito Yrigoyen",
  Zipcode: "B1832",
  Pluscode: "8QC7+22",
};

// Status data
const Status = {
  '0': "NO STATE",
  '1': "FOR SALE",
  '2': "FOR RENT",
  '3': "SOLD",
  '4': "TEMPO"
};

// Map status to Tailwind classes
const StatusClasses = {
  '0': "text-slate-500 bg-slate-500",
  '1': "text-forSale bg-forSale",
  '2': "text-forRent bg-forRent",
  '3': "text-Sold bg-Sold",
  '4': "text-forRentTemp bg-forRentTemp"
};

// Current status

const {currentStatus = '0'} = Astro.props; // Change this to test different states

const {Agency = "null"} = Astro.props;
---

<!-- CARD -->

<a href="" class="h-full rounded-2xl bg-primaryColor select-none text-terciaryColor flex flex-col justify-between duration-[0.15s] ease-in-out hover:outline hover:outline-2 hover:outline-secondaryColor">
  <div>
    <div class="w-full h-48 rounded-t-2xl">
      <img
        src="https://mansionesmiami.com/wp-content/uploads/2020/05/620-Arvida-Pkwy-Coral-Gables-FL-33156-1.jpg"
        alt=""
        class="w-full h-full object-cover rounded-t-2xl"
        draggable="false"
      />
    </div>
    <div class="px-3 pt-3 pb-0">
      <!-- Price -->
      <div class="flex items-center justify-between">
        <span class="font-secondaryFont text-2xl font-semibold">{Price}</span>
        <!-- Dynamic Status -->
        <span
        class={`font-secondaryFont font-semibold bg-opacity-35 h-full text-sm px-3 py-1 w-24 rounded-2xl text-center text-nowrap ${StatusClasses[currentStatus]}`}
        >
        {Status[currentStatus]}
      </span>
    </div>
    <!-- Title -->
    
    <span class="font-secondaryFont text-md font-semibold flex text-terciaryColor/75">{Extra}</span>
      <h3 class="font-primaryFont text-3xl mb-2 mt-1 hidden " id="title">{Title}</h3>

      <!-- Location -->
      <p class="font-secondaryFont mt-2 text-sm font-light leading-tight text-terciaryColor/75 flex">
        <img src="https://www.svgrepo.com/show/424575/location-direction-gps.svg" alt="Type Icon" class="mr-1 h-4 hidden" />
        {Location.Address}, {Location.City}, {Location.State}, {Location.Country}.
      </p>

    </div>
  </div>
  <div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-1 sm:gap-3 w-full px-4 py-4">
  
      <span class="flex justify-center flex-col sm:flex-row">
        <img src="https://cdn-icons-png.flaticon.com/512/1946/1946488.png" width="20px" height="20px" alt="a" class=" h-5 w-5">
        <p class="text-xs text-center justify-end w-full font-secondaryFont uppercase text-nowrap">Mansion</p>
      </span>
      <span class="flex justify-center flex-col sm:flex-row">
        <img src="https://cdn-icons-png.flaticon.com/512/93/93640.png" alt="a" width="20px" height="20px" class=" h-5 w-5">
        <p class="text-xs text-center justify-end w-full font-secondaryFont uppercase text-nowrap">1800 sqft</p>
      </span>
      <span class="flex justify-center flex-col sm:flex-row">
        <img src="https://cdn-icons-png.flaticon.com/512/833/833593.png" width="20px" height="20px" alt="a" class=" h-5 w-5">
        <p class="text-xs text-center justify-end w-full font-secondaryFont uppercase text-nowrap">10 years</p>
      </span>

      <span class="flex justify-center flex-col sm:flex-row">
        <img src="https://cdn-icons-png.flaticon.com/512/952/952772.png" width="20px" height="20px" alt="a" class=" h-5 w-5">
        <p class="text-xs text-center justify-end w-full font-secondaryFont uppercase text-nowrap">5 beds</p>
      </span>
      <span class="flex justify-center flex-col sm:flex-row">
        <img src="https://cdn-icons-png.flaticon.com/512/169/169301.png" width="20px" height="20px" alt="a" class=" h-5 w-5">
        <p class="text-xs text-center justify-end w-full font-secondaryFont uppercase text-nowrap">2.5 baths</p>
      </span>
      <span class="flex justify-center flex-col sm:flex-row">
        <img src="https://cdn-icons-png.flaticon.com/512/243/243232.png" width="20px" height="20px" alt="a" class=" h-5 w-5">
        <p class="text-xs text-center justify-end w-full font-secondaryFont uppercase text-nowrap">2 slots</p>
      </span>

    </div>

    <!--
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 w-full px-4 pb-4 pt-2">
    </div>
    -->
    
  </div>

  <!-- Specs 
  <div class="h-max stati mb-0 px-3 flex justify-center">
    <div class="w-fit m-auto  grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-2 text-sm text-terciaryColor">
      <span class="font-secondaryFont font-light flex items-center text-nowrap justify-start">
        <img src="https://www.svgrepo.com/show/253357/measure-ruler.svg" alt="Size Icon" class="mr-1 h-[1.2rem]" />
        1800 sqft
      </span>
      <span class="font-secondaryFont font-light flex items-center text-nowrap">
