---
import FeatureButton from "./subComponents/FeatureButton.astro"


---

<div class="max-w-[100vw]">
  <h1 class="text-center w-fit m-auto mt-[.75em] text-primaryColor font-secondaryFont text-[18px] pt-3">BROWSE BY MARKETPLACE</h1>
  
  <div class="my-[1.5em] w-full flex justify-center px-[2em] gap-[10px] flex-wrap flex-none">  
    <FeatureButton title="REAL ESTATE" image="https://images.unsplash.com/photo-1721902474248-3d6d2f2b595e?q=80&w=880&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" />
    <FeatureButton title="VEHICLES" image="https://images.unsplash.com/photo-1629644494884-7580538c3d43?q=80&w=889&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3Dhttps://images.pexels.com/photos/10550012/pexels-photo-10550012.jpeg" />
    <FeatureButton title="AIRCRAFTS" image="https://images.unsplash.com/photo-1682380116425-f103d66c5cf1?q=80&w=880&auto=format&full=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" />
    <FeatureButton title="SHIPS" image="https://www.charterworld.com/news/wp-content/uploads/2013/03/Mega-Yacht-Red-Square-by-Dunya-Yachts-Image-courtesy-of-Dunya-Yachts.jpg" />
  </div>
</div>

