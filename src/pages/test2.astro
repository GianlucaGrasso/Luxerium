    1: "STUDIOS",
    2: "PENTHOUSES",
    3: "LOFTS",
    4: "CONDOS",
}

const buildingTypes = { 
    1: "OFFICES",
    2: "WAREHOUSES",
    3: "HOTELS",
}

const landTypes = { 
    1: "RESIDENTIAL",
    2: "COMMERCIAL",
    3: "AGRICULTURAL",
    4: "INDUSTRIAL",
}

// VEHICLES FILTER

const vehicleTypes = { 
   1: "CARS",
   2: "MOTORCYCLES",
   3: "TRUCKS",
   4: "OFFROAD",
}

const carTypes = {
    1: "SPORTS CARS",
    2: "SUVS",
    3: "SEDANS",
    4: "HATCHBACKS",
    5: "COUPES",
    6: "CONVERTIBLES",
    7: "PICKUPS",
    8: "VANS",
    9: "SUPERCARS",
}

const motorcycleTypes = { 
    1: "STANDARD",
    2: "SPORT BIKES",
    3: "CRUISERS",
    4: "TOURING BIKES",
    5: "CHOPPER",
    6: "SCOOTER",
}

const truckTypes = { 
    1: "SEMI TRUCKS",
    2: "LIVESTOCK TRUCKS",
    3: "SMALL TRUCKS",
    4: "BOX TRUCKS",
}

const offroadTypes = { 
    1: "UTILITY ATVS",
    2: "SNOWMOBILES",
    3: "OFF-ROAD BIKES",
    4: "TASK VEHICLES",
}

// AIRCRAFTS FILTER

const aircraftTypes = { 
   1: "PRIVATE JETS",
   2: "COMMERCIAL AIRCRAFTS",
   3: "HELICOPTERS",
   4: "GLIDERS",
   5: "SEAPLANES",
   6: "EVTOLS",
}

// SHIPS FILTER

const shipTypes = { 
   1: "YACHTS",
   2: "CATAMARANS",
   3: "SAILBOATS",
   4: "BOATS",
   5: "CRUISERS",
   6: "JETSKIS"


}

