---
import Layout from "../layouts/Layout.astro";
import BrowseBy from "../components/subComponents/BrowseBy.astro";

// REAL ESTATE FILTER

const realEstateTypes = { 
    1: "HOUSES",
    2: "APARTMENTS",
    3: "BUILDINGS",
    4: "LANDS",
}

