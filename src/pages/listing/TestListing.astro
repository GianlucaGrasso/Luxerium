---
import Layout from "../../shared/presentation/layouts/Layout.astro"
import Navbar from "../../shared/presentation/components/layout/navbar/Navbar.astro"
import SecondaryNavbar from "../../shared/presentation/components/layout/navbar/SecondaryNavbar.astro"
import { supabase } from "../../shared/infrastructure/lib/supabase";
import GallerySlider from "../../shared/utils/listing-re/GallerySlider";

// Obtener datos en el SERVIDOR (esto se ejecuta en build time o SSR)
const { data } = await supabase
  .from('listingsRealEstate')
  .select('*')
  .limit(1)
  .single();

const listing = data || {};


const amenities = Array.isArray(listing.amenities) ? listing.amenities : [
  "SUM", "POOL", "GRILL", "GYM", "PLAYGROUND", "SECURITY", "ELEVATOR", "GARDEN", "TERRACE", "PARKING"
];


---

<Layout title="Test Listing Page">
  <Navbar />
  <SecondaryNavbar />

  <!-- CONTENEDOR GRID PARA DIVIDIR GALERIA CON INFORMACION --> 
  <main class="grid grid-cols-1 md:grid-cols-2 gap-0 h-full relative">
    
    <GallerySlider client:load />
    

    <!-- INFORMACION DEL LISTING REAL ESTATE -->
    <div class="flex flex-col h-auto w-full z-10 font-secondaryFont text-primaryColor">

      <!-- COMPONENTE DE INFORMACION AGENCY AGENT -->
      <section class="border-b border-b-primaryColor mb-4">
          <div class="relative items-center p-3 grid grid-cols-2 justify-end">
            <div class="flex w-fit bottom-0">
              {/* Agent Image */}
              <img
                src="https://thispersondoesnotexist.com/"
                alt="Agent Image"
                class="h-16 w-16 aspect-square rounded-xl object-cover"
                draggable="false"
              />
              
              <section>
                {/* Agent Details */}
                <div class="flex flex-col">
                  <div class="flex flex-col ml-2 w-full overflow-hidden">
                    <div class="flex flex-row gap-4">
                      <p class="font-secondaryFont font-medium text-md text-left truncate uppercase">
                        {listing.agentName_1} {listing.agentName_2}
                      </p>
                      |
                      <p class="font-secondaryFont font-medium text-md text-left truncate uppercase text-secondaryColor flex flex-row gap-2">
                        {listing.agency}
                        <img src="https://cdn-icons-png.flaticon.com/512/658/658098.png" alt="" class="h-4 w-4 invert m-auto">
                      </p>
                    </div>
                  </div>
                  
                  <div>
                    <button class=" bg-secondaryColor text-white font-secondaryFont text-sm ml-2 px-24 py-1 my-2 rounded-md hover:bg-transparent outline outline-1 hover:outline-secondaryColor transition-colors duration-300 uppercase">
                      Contact Agent
                    </button>
                  </div>
                </div>
              </section>
            </div>

            {/* Image Section */}
            <div class="absolute inset-y-0 right-0 overflow-hidden w-[35%] sm:w-[50%] md:w-[50%]">
              <img
                src="https://media-production.lp-cdn.com/cdn-cgi/image/format=auto,quality=85,fit=scale-down,width=960/https://media-production.lp-cdn.com/media/oev0qffxv6gsyz2fmvlf"
                alt="#"
                class="h-full object-cover w-full border-l"
                draggable="false"
              />
            </div>
          </div>
      </section>

      <!-- MAIN COMPONENT OF TITLE PRICE EXTRA AND LOCATION -->
      <section class="font-secondaryFont ml-4 flex flex-col gap-2">
        <div class=" w-full flex flex-row">
          <h1 class="text-lg">{( listing.features_bedrooms + "-BED " + listing.features_type + " in " + listing.location_address).toUpperCase() || 'DEFAULT LISTING TITLE'}</h1>

          <!-- IN PROGRESS -->
          <button class="w-4 h-4 right-0">
            Bookmark
          </button>
        </div>

        <h2 class="text-4xl text-secondaryColor font-secondaryFont"> JPY  ¥<span class="text-primaryColor">{listing.price || '999.999.999'} </span></h2>
        <h3 class="text-xl mt-[-0.5rem]"> ${listing.extra || '123.456'} per month </h3>
        <p class="text-md flex flex-row gap-2 align-middle opacity-75"> 
          <img src="https://cdn-icons-png.flaticon.com/512/0/619.png" alt="location" class="h-5 w-5 invert">  
          {listing.location_country.toUpperCase()} | {listing.location_city.toUpperCase()} | {listing.location_address.toUpperCase()} | {listing.location_zipcode.toUpperCase()}
        </p>
      </section>
      
      <!-- TABLE LIKE COMPONENT FOR FEATURES E.G. BEDROOMS BATHROOMS SPACES PARKING SLOTS ETC  -->
      <section class="font-secondaryFont my-4 px-4 border-y border-primaryColor/20">
        <table class="w-full">
          <tr class="flex justify-between items-stretch py-5">
            
            <td class="flex-1 flex flex-col items-center text-center text-xs border-r border-secondaryColor last:border-r-0 px-1">
              <img src="https://cdn-icons-png.flaticon.com/512/25/25694.png" alt="" class="h-6 w-6 mb-1 invert opacity-80">
              <span class="truncate">{listing.features_type.toUpperCase() || 'APARTMENT'}</span>
            </td>

            <td class="flex-1 flex flex-col items-center text-center text-xs border-r border-secondaryColor last:border-r-0 px-1">
              <img src="https://cdn-icons-png.flaticon.com/512/89/89977.png" alt="" class="h-6 w-6 mb-1 invert opacity-80">
              <span>{listing.features_bedrooms || '3'} BEDS</span>
            </td>
      
            <td class="flex-1 flex flex-col items-center text-center text-xs border-r border-secondaryColor last:border-r-0 px-1">
              <img src="https://cdn-icons-png.flaticon.com/512/194/194432.png" alt="" class="h-6 w-6 mb-1">
              <span>{listing.features_bathrooms || '2'} BATHS</span>
            </td>
      
            <td class="flex-1 flex flex-col items-center text-center text-xs border-r border-secondaryColor last:border-r-0 px-1">
              <img src="https://cdn-icons-png.flaticon.com/512/1810/1810848.png" alt="" class="h-6 w-6 mb-1 invert saturate-0 ">
              <span>{listing.features_slots || '1'} SLOT</span>
            </td>
      
            <td class="flex-1 flex flex-col items-center text-center text-xs border-r border-secondaryColor last:border-r-0 px-1">
              <img src="https://cdn-icons-png.flaticon.com/512/1295/1295211.png" alt="" class="h-6 w-6 mb-1 invert opacity-80">
              <span class="whitespace-nowrap">{listing.features_area || '120'} SQFT</span>
            </td>

            <td class="flex-1 flex flex-col items-center text-center text-xs border-r border-secondaryColor last:border-r-0 px-1">
              <img src="https://cdn-icons-png.flaticon.com/512/1067/1067374.png" alt="" class="h-6 w-6 mb-1 saturate-0">
              <span>BUILT IN {listing.features_year || '2020'}</span>
            </td>
                      
          </tr>
        </table>
      </section>
      
      <!-- EXTRA FEATURES LIKE SUM / GRILL / POOL / ETC -->
      <section class="py-2">
        <div class="flex flex-wrap justify-center gap-2">
          {amenities.map((amenity: string) => (
            <span 
              class="inline-block bg-secondaryColor/10 text-secondaryColor px-3 py-1 rounded-full text-sm font-medium 
                    transition-all duration-300 cursor-default select-none
                    hover:bg-secondaryColor hover:text-white 
                    hover:shadow-[0_0_15px_rgba(var(--secondary-color-rgb),0.5)] 
                    hover:-translate-y-0.5"
            >
              {amenity}
            </span>
          ))}
        </div>
      </section>


      <!-- DESCRIPTION COMPONENT  -->
      <section class="text-md tracking-wider mt-4 pt-4 w-full border-t border-primaryColor/20 pl-6 pr-6 pb-4">
        <p class="leading-5">
          <strong>{listing.description || '¡Oportunidad! Luminoso Departamento de 2 Ambientes a Estrenar en Belgrano C'}</strong>
        </p>
      </section>

      <!-- FULL LISTING DETAILS -->
        <section class="flex flex-col w-full mt-4 pb-8 uppercase shadow-md">
          <h2 class="text-center text-2xl uppercase pt-4 pb-4 text-secondaryColor font-semibold tracking-wide bg-secondaryColor/10 border-y border-primaryColor">
            Listing Details
          </h2>
        
          <div class="grid grid-cols-2 gap-6 mt-6 px-8 py-4">
            <div class="flex flex-col">
              <span class="font-bold text-primaryColor uppercase text-md text-center">Property Type</span>
              <span class="text-secondaryColor opacity-90 text-sm text-center">{listing.features_type || 'APARTMENT'}</span>
            </div>
            <div class="flex flex-col">
              <span class="font-bold text-primaryColor uppercase text-md text-center">Listing Agency ID</span>
              <span class="text-secondaryColor opacity-90 text-sm text-center">{listing.id || '00012345'}</span>
            </div>
            <div class="flex flex-col">
              <span class="font-bold text-primaryColor uppercase text-md text-center">Price</span>
              <span class="text-secondaryColor opacity-90 text-sm text-center">JPY ¥{listing.price || '999.999.999'}</span>
            </div>
            <div class="flex flex-col">
              <span class="font-bold text-primaryColor uppercase text-md text-center">Status</span>
              <span class="text-secondaryColor opacity-90 text-sm text-center">{listing.status || 'FOR SALE'}</span>
            </div>
            <div class="flex flex-col">
              <span class="font-bold text-primaryColor uppercase text-md text-center">Area</span>
              <span class="text-secondaryColor opacity-90 text-sm text-center">{listing.features_area || '120'} SQFT</span>
            </div>
            <div class="flex flex-col">
              <span class="font-bold text-primaryColor uppercase text-md text-center">Year Built</span>
              <span class="text-secondaryColor opacity-90 text-sm text-center">{listing.features_year || '2020'}</span>
            </div>
            <div class="flex flex-col">
              <span class="font-bold text-primaryColor uppercase text-md text-center">Estimated Property Tax</span>
              <span class="text-secondaryColor opacity-90 text-sm text-center">JPY ¥{listing.estimated_property_tax || '50,000'}</span>
            </div>
            <div class="flex flex-col">
              <span class="font-bold text-primaryColor uppercase text-md text-center">Estimated Rent Price</span>
              <span class="text-secondaryColor opacity-90 text-sm text-center">JPY ¥{listing.estimated_rent_price || '100,000'} per month</span>
            </div>
            <div class="flex flex-col">
              <span class="font-bold text-primaryColor uppercase text-md text-center">Lot Size</span>
              <span class="text-secondaryColor opacity-90 text-sm text-center">{listing.lot_size || '500'} SQFT</span>
            </div>
            <div class="flex flex-col">
              <span class="font-bold text-primaryColor uppercase text-md text-center">Location Highlights</span>
              <span class="text-secondaryColor opacity-90 text-sm text-center">{listing.location_highlights || 'Near schools, public transport, and shopping centers'}</span>
            </div>
            <div class="flex flex-col">
              <span class="font-bold text-primaryColor uppercase text-md text-center">Energy Efficiency</span>
              <span class="text-secondaryColor opacity-90 text-sm text-center">{listing.energy_efficiency || 'A+'}</span>
            </div>
            <div class="flex flex-col">
              <span class="font-bold text-primaryColor uppercase text-md text-center">Air Conditioning</span>
              <span class="text-secondaryColor opacity-90 text-sm text-center">{listing.air_conditioning || 'Centralized'}</span>
            </div>
            <div class="flex flex-col">
              <span class="font-bold text-primaryColor uppercase text-md text-center">Garage Size</span>
              <span class="text-secondaryColor opacity-90 text-sm text-center">{listing.garage_size || '2'} Cars</span>
            </div>
            <div class="flex flex-col">
              <span class="font-bold text-primaryColor uppercase text-md text-center">Parking Spaces</span>
              <span class="text-secondaryColor opacity-90 text-sm text-center">{listing.features_slots || '1'} Slot</span>
            </div>
            <div class="flex flex-col">
              <span class="font-bold text-primaryColor uppercase text-md text-center">Neighborhood</span>
              <span class="text-secondaryColor opacity-90 text-sm text-center">{listing.neighborhood || 'Quiet and family-friendly area'}</span>
            </div>
            <div class="flex flex-col">
              <span class="font-bold text-primaryColor uppercase text-md text-center">Nearby Amenities</span>
              <span class="text-secondaryColor opacity-90 text-sm text-center">{listing.nearby_amenities || 'Grocery stores, parks, and restaurants'}</span>
            </div>
            <div class="flex flex-col">
              <span class="font-bold text-primaryColor uppercase text-md text-center">School District</span>
              <span class="text-secondaryColor opacity-90 text-sm text-center">{listing.school_district || 'Top-rated local schools'}</span>
            </div>
            <div class="flex flex-col">
              <span class="font-bold text-primaryColor uppercase text-md text-center">Public Transport Access</span>
              <span class="text-secondaryColor opacity-90 text-sm text-center">{listing.public_transport || 'Close to bus and train stations'}</span>
            </div>
          </div>
        </section>

      <!-- FAQ temporary disabled -->
      <section class="flex flex-col w-full pb-8 border-t border-primaryColor hidden">
        <h2 class="text-center text-2xl uppercase pt-2 pb-2 text-secondaryColor font-medium tracking-wide bg-secondaryColor/10 border-b">
          FAQ
        </h2>
      
        <details class="group w-full border-b border-primaryColor rounded-sm overflow-hidden transition-all duration-300">
          <summary class="flex justify-center items-center list-none py-3 px-6 text-center text-primaryColor cursor-pointer select-none hover:bg-primaryColor/5 transition-colors uppercase text-sm font-bold">
            ¿What taxes does this property pay?
          </summary>
          <div class="py-4 px-6 text-center text-primaryColor bg-secondaryColor/10 border-t border-primaryColor/20 animate-in fade-in slide-in-from-top-1 duration-300">
            <p class="text-sm leading-relaxed opacity-90">
              It pays: Annual property tax and local maintenance fees.
            </p>
          </div>
        </details>
      
        <details class="group w-full border-b border-primaryColor rounded-sm overflow-hidden transition-all duration-300">
          <summary class="flex justify-center items-center list-none py-3 px-6 text-center text-primaryColor cursor-pointer select-none hover:bg-primaryColor/5 transition-colors uppercase text-sm font-bold">
            Is the price negotiable?
          </summary>
          <div class="py-4 px-6 text-center text-primaryColor bg-secondaryColor/10 border-t border-primaryColor/20 animate-in fade-in slide-in-from-top-1 duration-300">
            <p class="text-sm leading-relaxed opacity-90">
              Offers are considered based on payment terms and closing dates.
            </p>
          </div>
        </details>
      
        <details class="group w-full border-b border-primaryColor rounded-sm overflow-hidden transition-all duration-300">
          <summary class="flex justify-center items-center list-none py-3 px-6 text-center text-primaryColor cursor-pointer select-none hover:bg-primaryColor/5 transition-colors uppercase text-sm font-bold">
            When is the property available?
          </summary>
          <div class="py-4 px-6 text-center text-primaryColor bg-secondaryColor/10 border-t border-primaryColor/20 animate-in fade-in slide-in-from-top-1 duration-300">
            <p class="text-sm leading-relaxed opacity-90">
              Immediate possession is available upon completion of the legal paperwork.
            </p>
          </div>
        </details>
      </section>
    
      
    </div>
  </main>
</Layout>