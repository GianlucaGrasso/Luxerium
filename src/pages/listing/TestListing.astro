    <!-- ================= SCRIPT DEFINITIVO (con subcomponentes y chunk) ================= -->
    <script define:vars={{ realEstateTypes }}>
      // ================================================================
      // 1. CHUNK DE DATOS: carga del JSON con múltiples fuentes
      // ================================================================
      const CACHE_EXPIRY_DAYS = 7;
      const GEONAMES_USERNAME = 'geonames'; // Cámbialo por tu usuario de geonames.org

      // Funciones de caché
      function getCache(key) {
        try {
          const raw = localStorage.getItem(key);
          if (!raw) return null;
          const { data, timestamp } = JSON.parse(raw);
          const age = (Date.now() - timestamp) / (1000 * 60 * 60 * 24);
          if (age > CACHE_EXPIRY_DAYS) {
            localStorage.removeItem(key);
            return null;
          }
          return data;
        } catch { return null; }
      }

      function setCache(key, data) {
        try {
          localStorage.setItem(key, JSON.stringify({ data, timestamp: Date.now() }));
        } catch {}
      }

      // Cargar el chunk de datos (países, estados, ciudades)
      async function loadGeoChunk() {
        const cached = getCache('geoChunk_v2');
        if (cached) {
          console.log('✅ GeoChunk cargado desde caché');
          return cached;
        }

        // Fuentes en orden de prioridad
        const sources = [
          'https://cdn.jsdelivr.net/npm/countries-states-cities-database@1.0.0/countries%2Bstates%2Bcities.json',
          'https://raw.githubusercontent.com/dr5hn/countries-states-cities-database/master/countries%2Bstates%2Bcities.json'
        ];

        for (const url of sources) {
          try {
            console.log(`Intentando cargar desde: ${url}`);
            const res = await fetch(url, { mode: 'cors' });
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const data = await res.json();
            // Validar estructura mínima
            if (Array.isArray(data) && data.length > 0 && data[0].iso2) {
              const chunk = { countries: data };
              setCache('geoChunk_v2', chunk);
              console.log(`✅ GeoChunk cargado desde ${url}`);
              return chunk;
            }
          } catch (err) {
            console.warn(`Falló fuente ${url}:`, err.message);
          }
        }

        // Si todo falla, devolver null (usaremos GeoNames)
        console.warn('⚠️ No se pudo cargar el chunk de datos. Se usará GeoNames como fallback.');
        return null;
      }

      // ================================================================
      // 2. ESTADO GLOBAL
      // ================================================================
      const state = {
        chunk: null,          // { countries: [ { iso2, name, states: [ { name, cities: [] } ] } ] }
        countries: [],        // [{ name, isoCode }]
        selectedCountry: null,
        selectedState: null,
        selectedCity: null,
      };

      // ================================================================
      // 3. REFERENCIAS DOM
      // ================================================================
      const $ = (id) => document.getElementById(id);
      const searchCountry = $('search-country');
      const suggestCountry = $('suggest-country');
      const inputCountry = $('input-country');
      const inputCountryCode = $('input-country-code');
      const selectState = $('select-state');
      const selectCity = $('select-city');
      const searchNeighborhood = $('search-neighborhood');
      const suggestNeighborhood = $('suggest-neighborhood');
      const inputNeighborhood = $('input-neighborhood');
      const searchStation = $('search-station');
      const suggestStation = $('suggest-station');
      const inputStation = $('input-station');
      const searchStreet = $('search-street');
      const suggestStreet = $('suggest-street');
      const inputStreet = $('input-street');
      const inputHeight = $('input-height');
      const addressPreview = $('address-preview-card');
      const wrapperNeighborhood = $('wrapper-neighborhood-section');
      const wrapperStreet = $('wrapper-street-section');
      const wrapperStation = $('wrapper-subway-station');
      const btnSubmit = $('btn-submit-listing');
      const selectType = $('select-property-type');
      const selectSubtype = $('select-property-subtype');
      const selectStatus = $('select-status');
      const inputPrice = $('input-price');
      const inputRentalPrice = $('input-rental-price');
      const totalArea = $('total_area');
      const boxSale = $('box-sale');
      const boxRent = $('box-rent');
      const selectRentalCurrency = $('select-rental-currency');
      const groupBuilding = $('group-building-amenities');
      const groupPrivate = $('group-private-amenities');
      const residentialSpecs = $('residential-specs');
      const unitSpecSection = $('unit-spec-section');
      const selectOrientation = $('select-orientation');
      const inputFloor = $('input-floor');
      const stateError = $('state-error');
      const cityError = $('city-error');
      const countryError = $('country-error');

      // ================================================================
      // 4. CONFIGURACIÓN INTERNACIONAL (etiquetas)
      // ================================================================
      const countryConfig = {
        JP: { stateLabel: 'Prefectura', cityLabel: 'Municipio', neighborhoodLabel: 'Distrito / Chome', streetLabel: 'Bloque', heightLabel: 'Nº Edificio', showStation: true },
        KR: { stateLabel: 'Do / Provincia', cityLabel: 'Si / Ciudad', neighborhoodLabel: 'Gu / Distrito', streetLabel: 'Calle / Bloque', heightLabel: 'Número', showStation: false },
        CN: { stateLabel: 'Provincia', cityLabel: 'Ciudad', neighborhoodLabel: 'Distrito', streetLabel: 'Calle', heightLabel: 'Número', showStation: false },
        RU: { stateLabel: 'Óblast / Krai', cityLabel: 'Ciudad', neighborhoodLabel: 'Distrito', streetLabel: 'Calle', heightLabel: 'Número', showStation: false },
        DE: { stateLabel: 'Bundesland', cityLabel: 'Stadt', neighborhoodLabel: 'Stadtteil', streetLabel: 'Straße', heightLabel: 'Hausnummer', showStation: false },
        GB: { stateLabel: 'Condado', cityLabel: 'Ciudad', neighborhoodLabel: 'Distrito', streetLabel: 'Calle', heightLabel: 'Número', showStation: true },
        FR: { stateLabel: 'Région', cityLabel: 'Ville', neighborhoodLabel: 'Quartier', streetLabel: 'Rue', heightLabel: 'Numéro', showStation: true },
        US: { stateLabel: 'Estado', cityLabel: 'Ciudad', neighborhoodLabel: 'Barrio', streetLabel: 'Calle', heightLabel: 'Número', showStation: false },
        default: { stateLabel: 'Provincia / Estado', cityLabel: 'Ciudad / Localidad', neighborhoodLabel: 'Barrio / Comuna', streetLabel: 'Calle / Avenida', heightLabel: 'Altura / Número', showStation: false }
      };

      function adaptInterfaceToCountry(code) {
        const config = countryConfig[code] || countryConfig.default;
        $('label-state').innerText = config.stateLabel;
        $('label-city').innerText = config.cityLabel;
        $('label-neighborhood').innerText = config.neighborhoodLabel;
        $('label-street').innerText = config.streetLabel;
        $('label-height').innerText = config.heightLabel;
        if (config.showStation) wrapperStation.classList.remove('hidden');
        else wrapperStation.classList.add('hidden');
      }

      // ================================================================
      // 5. FUNCIONES DE CARGA DE ESTADOS Y CIUDADES (desde chunk o GeoNames)
      // ================================================================
      function getCountryData(isoCode) {
        if (!state.chunk) return null;
        return state.chunk.countries.find(c => c.iso2 === isoCode) || null;
      }

      // Cargar estados (desde chunk o GeoNames)
      async function loadStates(countryCode) {
        selectState.innerHTML = '<option value="">Cargando provincias...</option>';
        selectState.disabled = true;
        stateError.classList.add('hidden');

        const countryData = getCountryData(countryCode);
        if (countryData && countryData.states && countryData.states.length > 0) {
          const states = countryData.states.map(s => ({ name: s.name }));
          populateStateSelect(states);
          return;
        }

        // Fallback a GeoNames
        await loadStatesFromGeoNames(countryCode);
      }

      async function loadStatesFromGeoNames(countryCode) {
        const cacheKey = `states_${countryCode}`;
        const cached = getCache(cacheKey);
        if (cached) {
          populateStateSelect(cached);
          return;
        }

        try {
          const url = `https://api.geonames.org/searchJSON?country=${countryCode}&featureCode=ADM1&maxRows=1000&username=${GEONAMES_USERNAME}`;
          const res = await fetch(url);
          if (!res.ok) throw new Error('GeoNames error');
          const data = await res.json();
          if (data.geonames && data.geonames.length > 0) {
            const unique = new Map();
            data.geonames.forEach(s => {
              const name = s.name || s.adminName1;
              if (name && !unique.has(name)) unique.set(name, { name });
            });
            const list = Array.from(unique.values());
            setCache(cacheKey, list);
            populateStateSelect(list);
          } else {
            stateError.classList.remove('hidden');
            selectState.innerHTML = '<option value="">No hay provincias disponibles</option>';
            selectState.disabled = true;
          }
        } catch (err) {
          console.warn('Error cargando estados desde GeoNames:', err);
          stateError.classList.remove('hidden');
          selectState.innerHTML = '<option value="">Error al cargar</option>';
          selectState.disabled = true;
        }
      }

      // Cargar ciudades (desde chunk o GeoNames)
      async function loadCities(stateName, countryCode) {
        selectCity.innerHTML = '<option value="">Cargando ciudades...</option>';
        selectCity.disabled = true;
        cityError.classList.add('hidden');

        const countryData = getCountryData(countryCode);
        if (countryData) {
          const state = countryData.states.find(s => s.name === stateName);
          if (state && state.cities && state.cities.length > 0) {
            const cities = state.cities.map(c => ({ name: c }));
            populateCitySelect(cities);
            return;
          }
        }

        await loadCitiesFromGeoNames(stateName, countryCode);
      }

      async function loadCitiesFromGeoNames(stateName, countryCode) {
        const cacheKey = `cities_${countryCode}_${stateName}`;
        const cached = getCache(cacheKey);
        if (cached) {
          populateCitySelect(cached);
          return;
        }

        try {
          const url = `https://api.geonames.org/searchJSON?q=${encodeURIComponent(stateName)}&country=${countryCode}&featureCode=PPL&maxRows=1000&username=${GEONAMES_USERNAME}`;
          const res = await fetch(url);
          if (!res.ok) throw new Error('GeoNames error');
          const data = await res.json();
          if (data.geonames && data.geonames.length > 0) {
            const unique = new Map();
            data.geonames.forEach(c => {
              const name = c.name || c.toponymName;
              if (name && !unique.has(name)) unique.set(name, { name });
            });
            const list = Array.from(unique.values());
            setCache(cacheKey, list);
            populateCitySelect(list);
          } else {
            cityError.classList.remove('hidden');
            selectCity.innerHTML = '<option value="">No hay ciudades disponibles</option>';
            selectCity.disabled = true;
          }
        } catch (err) {
          console.warn('Error cargando ciudades desde GeoNames:', err);
          cityError.classList.remove('hidden');
          selectCity.innerHTML = '<option value="">Error al cargar</option>';
          selectCity.disabled = true;
        }
      }

      function populateStateSelect(list) {
        selectState.innerHTML = '<option value="">Seleccione una Provincia...</option>';
        list.forEach(s => {
          const opt = document.createElement('option');
          opt.value = s.name;
          opt.innerText = s.name.toUpperCase();
          selectState.appendChild(opt);
        });
        selectState.disabled = false;
        stateError.classList.add('hidden');
        // Resetear ciudad
        selectCity.innerHTML = '<option value="">Seleccione una Provincia primero...</option>';
        selectCity.disabled = true;
        wrapperNeighborhood.classList.add('hidden');
        wrapperStreet.classList.add('hidden');
        addressPreview.classList.add('hidden');
      }

      function populateCitySelect(list) {
        selectCity.innerHTML = '<option value="">Seleccione una Localidad...</option>';
        list.forEach(c => {
          const opt = document.createElement('option');
          opt.value = c.name;
          opt.innerText = c.name.toUpperCase();
          selectCity.appendChild(opt);
        });
        selectCity.disabled = false;
        cityError.classList.add('hidden');
        wrapperNeighborhood.classList.remove('hidden');
        wrapperStreet.classList.remove('hidden');
      }

      // ================================================================
      // 6. SELECCIÓN DE PAÍS
      // ================================================================
      async function selectCountry(c) {
        searchCountry.value = c.name;
        inputCountry.value = c.name;
        inputCountryCode.value = c.isoCode;
        suggestCountry.classList.add('hidden');
        countryError.classList.add('hidden');

        adaptInterfaceToCountry(c.isoCode);
        await loadStates(c.isoCode);
        // Resetear ciudad
        selectCity.innerHTML = '<option value="">Seleccione una Provincia primero...</option>';
        selectCity.disabled = true;
        wrapperNeighborhood.classList.add('hidden');
        wrapperStreet.classList.add('hidden');
        addressPreview.classList.add('hidden');
        validateForm();
      }

      // ================================================================
      // 7. AUTOCOMPLETADO DE PAÍS (todos los países)
      // ================================================================
      function renderCountrySuggestions(filter = '') {
        suggestCountry.innerHTML = '';
        const query = filter.trim().toLowerCase();
        let list = state.countries;
        if (query.length > 0) {
          list = list.filter(c => c.name.toLowerCase().includes(query));
        }
        if (list.length === 0) {
          suggestCountry.classList.add('hidden');
          return;
        }
        list.forEach(c => {
          const row = document.createElement('div');
          row.className = "p-2.5 text-[10px] text-neutral-300 hover:bg-neutral-900 cursor-pointer uppercase font-bold transition-colors";
          row.innerText = c.name;
          row.addEventListener('click', () => selectCountry(c));
          suggestCountry.appendChild(row);
        });
        suggestCountry.classList.remove('hidden');
      }

      searchCountry.addEventListener('focus', () => {
        if (state.countries.length > 0) renderCountrySuggestions('');
      });

      searchCountry.addEventListener('input', () => {
        const val = searchCountry.value.trim();
        if (val.length === 0) {
          suggestCountry.classList.add('hidden');
          countryError.classList.add('hidden');
          return;
        }
        renderCountrySuggestions(val);
      });

      searchCountry.addEventListener('blur', () => {
        setTimeout(() => {
          suggestCountry.classList.add('hidden');
          const entered = searchCountry.value.trim();
          const found = state.countries.some(c => c.name.toLowerCase() === entered.toLowerCase());
          if (entered && !found) {
            countryError.classList.remove('hidden');
          } else {
            countryError.classList.add('hidden');
          }
        }, 200);
      });

      document.addEventListener('click', (e) => {
        if (!e.target.closest('#search-country') && !e.target.closest('#suggest-country')) {
          suggestCountry.classList.add('hidden');
        }
      });

      // ================================================================
      // 8. EVENTOS DE ESTADO Y CIUDAD
      // ================================================================
      selectState.addEventListener('change', async () => {
        const stateName = selectState.value;
        const countryCode = inputCountryCode.value;
        if (stateName && countryCode) {
          await loadCities(stateName, countryCode);
          validateForm();
        } else {
          selectCity.innerHTML = '<option value="">Seleccione una Provincia primero...</option>';
          selectCity.disabled = true;
          wrapperNeighborhood.classList.add('hidden');
          wrapperStreet.classList.add('hidden');
          addressPreview.classList.add('hidden');
          validateForm();
        }
      });

      selectCity.addEventListener('change', () => {
        if (selectCity.value) {
          wrapperNeighborhood.classList.remove('hidden');
          wrapperStreet.classList.remove('hidden');
          searchNeighborhood.value = '';
          inputNeighborhood.value = '';
          searchStreet.value = '';
          inputStreet.value = '';
          inputHeight.value = '';
          searchStation.value = '';
        } else {
          wrapperNeighborhood.classList.add('hidden');
          wrapperStreet.classList.add('hidden');
        }
        validateForm();
      });

      // ================================================================
      // 9. BUSCADORES DINÁMICOS (barrio, estación, calle) con Nominatim
      // ================================================================
      const nominatimCache = new Map();
      const DEBOUNCE_DELAY = 300;

      function createSuggestionHandler(inputEl, suggestEl, queryUrl, onSelect, filterFn = null) {
        let debounceTimer;
        inputEl.addEventListener('input', () => {
          clearTimeout(debounceTimer);
          const val = inputEl.value.trim();
          if (val.length < 2) {
            suggestEl.classList.add('hidden');
            return;
          }
          debounceTimer = setTimeout(async () => {
            const cacheKey = queryUrl(val);
            if (nominatimCache.has(cacheKey)) {
              renderSuggestions(nominatimCache.get(cacheKey), suggestEl, onSelect);
              return;
            }
            try {
              const res = await fetch(cacheKey, { headers: { 'User-Agent': 'Luxerium/6.0' } });
              let data = await res.json();
              if (filterFn) data = data.filter(filterFn);
              nominatimCache.set(cacheKey, data);
              renderSuggestions(data, suggestEl, onSelect);
            } catch {
              suggestEl.classList.add('hidden');
            }
          }, DEBOUNCE_DELAY);
        });
      }

      function renderSuggestions(data, suggestEl, onSelect) {
        suggestEl.innerHTML = '';
        if (data.length === 0) {
          suggestEl.classList.add('hidden');
          return;
        }
        suggestEl.classList.remove('hidden');
        data.slice(0, 5).forEach(item => {
          const row = document.createElement('div');
          row.className = "p-2.5 text-[10px] text-neutral-300 hover:bg-neutral-900 cursor-pointer uppercase font-bold transition-colors";
          row.innerText = item.display_name;
          row.addEventListener('click', () => {
            onSelect(item);
            suggestEl.classList.add('hidden');
          });
          suggestEl.appendChild(row);
        });
      }

      // Barrio
      createSuggestionHandler(
        searchNeighborhood,
        suggestNeighborhood,
        (q) => `https://nominatim.openstreetmap.org/search?format=json&addressdetails=1&q=${encodeURIComponent(q + ' ' + (selectCity.value || '') + ' ' + inputCountry.value)}&accept-language=es&limit=5`,
        (item) => {
          const name = item.address?.suburb || item.address?.neighbourhood || item.address?.quarter || item.display_name.split(',')[0];
          searchNeighborhood.value = name;
          inputNeighborhood.value = name;
          $('input-postal').value = item.address?.postcode || 'N/A';
          $('input-latitude').value = item.lat;
          $('input-longitude').value = item.lon;
          updateAddressPreview();
          validateForm();
        },
        (item) => !['city', 'state', 'country', 'province', 'region'].includes(item.addresstype)
      );

      // Estación
      createSuggestionHandler(
        searchStation,
        suggestStation,
        (q) => `https://nominatim.openstreetmap.org/search?format=json&addressdetails=1&q=${encodeURIComponent(q + ' station ' + (selectCity.value || '') + ' ' + inputCountry.value)}&accept-language=es&limit=5`,
        (item) => {
          const name = item.address?.railway || item.address?.station || item.display_name.split(',')[0];
          searchStation.value = name;
          inputStation.value = name;
          updateAddressPreview();
        },
        (item) => item.class === 'railway' || item.type === 'station' || item.address?.railway
      );

      // Calle
      createSuggestionHandler(
        searchStreet,
        suggestStreet,
        (q) => `https://nominatim.openstreetmap.org/search?format=json&addressdetails=1&q=${encodeURIComponent(q + ' ' + (selectCity.value || '') + ' ' + (selectState.value || '') + ' ' + inputCountry.value)}&accept-language=es&limit=5`,
        (item) => {
          const road = item.address?.road || item.display_name.split(',')[0];
          searchStreet.value = road;
          inputStreet.value = road;
          if (!inputNeighborhood.value) {
            const hood = item.address?.suburb || item.address?.neighbourhood || 'Centro';
            searchNeighborhood.value = hood;
            inputNeighborhood.value = hood;
          }
          $('input-postal').value = item.address?.postcode || 'N/A';
          $('input-latitude').value = item.lat;
          $('input-longitude').value = item.lon;
          updateAddressPreview();
          validateForm();
        },
        (item) => item.addresstype === 'road' || item.addresstype === 'street'
      );

      // ================================================================
      // 10. ALTURA, PREVISUALIZACIÓN, ESTIMADOR
      // ================================================================
      inputHeight.addEventListener('input', () => {
        updateAddressPreview();
        calculatePrediction();
        validateForm();
      });

      function updateAddressPreview() {
        const street = inputStreet.value;
        const height = inputHeight.value.trim();
        const country = inputCountry.value;
        const state = selectState.value;
        const city = selectCity.value;
        const neighborhood = inputNeighborhood.value || 'Centro';
        const postal = $('input-postal').value || 'N/A';
        const station = searchStation.value;
        const code = inputCountryCode.value.toUpperCase();
        const isJapan = code === 'JP';

        if (isJapan) {
          if (state && city && neighborhood) {
            document.getElementById('preview-address').innerText = `${state}, ${city}, ${neighborhood}`;
            document.getElementById('preview-details').innerText = `${street ? 'Bloque: ' + street : ''} ${height ? 'Nº: ' + height : ''} ${station ? '(Estación: ' + station + ')' : ''} | CP: ${postal} | ${country}`;
            addressPreview.classList.remove('hidden');
          } else {
            addressPreview.classList.add('hidden');
          }
        } else {
          if (street && height && state && city) {
            document.getElementById('preview-address').innerText = `${street} ${height}`;
            document.getElementById('preview-details').innerText = `Barrio: ${neighborhood} | Localidad: ${city} | Provincia: ${state} | CP: ${postal} | ${country}`;
            addressPreview.classList.remove('hidden');
          } else {
            addressPreview.classList.add('hidden');
          }
        }
      }

      function calculatePrediction() {
        const area = Number(totalArea.value) || 0;
        const orientation = selectOrientation.value;
        const floor = Number(inputFloor.value) || 1;
        const hood = inputNeighborhood.value || "";
        if (area <= 0) return;

        let base = 2200;
        if (hood.toLowerCase().includes('palermo')) base = 3100;
        if (hood.toLowerCase().includes('recoleta')) base = 3400;
        if (hood.toLowerCase().includes('shibuya')) base = 8500;
        if (hood.toLowerCase().includes('shinjuku')) base = 7800;

        let mult = 1.0;
        if (orientation === 'norte') mult = 1.08;
        if (floor > 5) mult *= 1.05;

        const result = Math.round(area * base * mult);
        document.getElementById('estimated-price').innerText = new Intl.NumberFormat('es-AR').format(result);
        document.getElementById('estimated-m2').innerText = `~ USD ${base}/m² en ${hood || 'Zona'}`;
      }

      totalArea.addEventListener('input', calculatePrediction);
      selectOrientation.addEventListener('change', calculatePrediction);
      inputFloor.addEventListener('input', calculatePrediction);

      // ================================================================
      // 11. VALIDACIÓN
      // ================================================================
      function validateForm() {
        const countryVal = inputCountry.value;
        const countryOk = countryVal && state.countries.some(c => c.name.toLowerCase() === countryVal.toLowerCase());

        const stateOk = selectState.value && selectState.value !== '';
        const cityOk = selectCity.value && selectCity.value !== '';

        const code = inputCountryCode.value.toUpperCase();
        const isJapan = code === 'JP';
        const streetOk = isJapan ? true : (inputStreet.value && inputStreet.value.trim() !== '');
        const heightOk = isJapan ? true : (inputHeight.value && inputHeight.value.trim() !== '');
        const neighborhoodOk = isJapan ? (inputNeighborhood.value && inputNeighborhood.value.trim() !== '') : true;
        const addressOk = (streetOk && heightOk && neighborhoodOk) || (isJapan && neighborhoodOk);

        const typeOk = selectType.value && selectType.value !== '';
        const areaOk = Number(totalArea.value) > 0;

        const status = selectStatus.value;
        let priceOk = false;
        if (status === 'sale') {
          priceOk = inputPrice.value && inputPrice.value.replace(/\D/g, '').length > 0;
        } else {
          priceOk = inputRentalPrice.value && inputRentalPrice.value.replace(/\D/g, '').length > 0;
        }

        const ready = countryOk && stateOk && cityOk && addressOk && typeOk && areaOk && priceOk;

        countryError.classList.toggle('hidden', countryOk);
        stateError.classList.toggle('hidden', stateOk);
        cityError.classList.toggle('hidden', cityOk);
        $('area-error').classList.toggle('hidden', areaOk);
        $('type-error').classList.toggle('hidden', typeOk);
        $('price-error').classList.toggle('hidden', !(status === 'sale' && !priceOk));
        $('rent-error').classList.toggle('hidden', !(status === 'rent' && !priceOk));

        if (ready) {
          btnSubmit.disabled = false;
          btnSubmit.classList.replace('bg-neutral-800', 'bg-secondaryColor');
          btnSubmit.classList.replace('text-neutral-500', 'text-white');
          btnSubmit.classList.replace('cursor-not-allowed', 'cursor-pointer');
          btnSubmit.classList.remove('border-neutral-700/50');
          btnSubmit.innerText = "Guardar y Publicar Ficha de Propiedad";
        } else {
          btnSubmit.disabled = true;
          btnSubmit.classList.replace('bg-secondaryColor', 'bg-neutral-800');
          btnSubmit.classList.replace('text-white', 'text-neutral-500');
          btnSubmit.classList.replace('cursor-pointer', 'cursor-not-allowed');
          btnSubmit.classList.add('border-neutral-700/50');
          btnSubmit.innerText = "Guardar y Publicar Ficha (Complete los campos obligatorios)";
        }
      }

      document.querySelectorAll('#form-listing input, #form-listing select, #form-listing textarea').forEach(el => {
        el.addEventListener('change', validateForm);
        el.addEventListener('input', validateForm);
      });

      // ================================================================
      // 12. LÓGICA DE TIPO DE OPERACIÓN Y TIPOLOGÍA
      // ================================================================
      selectStatus.addEventListener('change', (e) => {
        if (e.target.value === 'sale') {
          boxSale.classList.remove('opacity-40');
          inputPrice.disabled = false;
          boxRent.classList.add('opacity-40');
          inputRentalPrice.disabled = true;
          inputRentalPrice.value = '';
          selectRentalCurrency.disabled = true;
        } else {
          boxRent.classList.remove('opacity-40');
          inputRentalPrice.disabled = false;
          selectRentalCurrency.disabled = false;
          boxSale.classList.add('opacity-40');
          inputPrice.disabled = true;
          inputPrice.value = '';
        }
        validateForm();
      });

      selectType.addEventListener('change', (e) => {
        const key = e.target.value;
        selectSubtype.innerHTML = '<option value="">Seleccionar Subtipo...</option>';
        if (!key) {
          selectSubtype.disabled = true;
          validateForm();
          return;
        }
        if (key === 'house') {
          groupBuilding.classList.add('hidden');
          groupPrivate.classList.remove('hidden');
          unitSpecSection.classList.add('hidden');
          residentialSpecs.classList.remove('opacity-30', 'pointer-events-none');
        } else if (key === 'apartment') {
          groupBuilding.classList.remove('hidden');
          groupPrivate.classList.remove('hidden');
          unitSpecSection.classList.remove('hidden');
          residentialSpecs.classList.remove('opacity-30', 'pointer-events-none');
        } else if (key === 'land') {
          groupBuilding.classList.add('hidden');
          groupPrivate.classList.add('hidden');
          unitSpecSection.classList.add('hidden');
          residentialSpecs.classList.add('opacity-30', 'pointer-events-none');
        } else {
          groupBuilding.classList.remove('hidden');
          groupPrivate.classList.remove('hidden');
        }
        const subTypes = realEstateTypes[key]?.types || {};
        Object.entries(subTypes).forEach(([subKey, subType]) => {
          if (subKey === 'studio') return;
          const opt = document.createElement('option');
          opt.value = subKey;
          opt.innerText = subType.title;
          selectSubtype.appendChild(opt);
        });
        selectSubtype.disabled = false;
        validateForm();
      });

      // ================================================================
      // 13. INICIALIZACIÓN
      // ================================================================
      window.addEventListener('DOMContentLoaded', async () => {
        // Cargar el chunk de datos
        state.chunk = await loadGeoChunk();

        // Si hay chunk, extraer países
        if (state.chunk) {
          state.countries = state.chunk.countries.map(c => ({ name: c.name, isoCode: c.iso2 }));
          state.countries.sort((a, b) => a.name.localeCompare(b.name));
          console.log(`✅ ${state.countries.length} países cargados`);
        } else {
          // Fallback: obtener países desde GeoNames (solo nombres, sin estados)
          try {
            const res = await fetch(`https://api.geonames.org/countryInfoJSON?username=${GEONAMES_USERNAME}`);
            const data = await res.json();
            if (data.geonames) {
              state.countries = data.geonames.map(c => ({ name: c.countryName, isoCode: c.isoAlpha2 }));
              state.countries.sort((a, b) => a.name.localeCompare(b.name));
              console.log(`✅ ${state.countries.length} países cargados desde GeoNames (fallback)`);
            }
          } catch (err) {
            console.warn('Falló carga de países desde GeoNames:', err);
            // Último recurso: lista mínima de países para no romper
            state.countries = [
              { name: "Argentina", isoCode: "AR" }, { name: "Brasil", isoCode: "BR" },
              { name: "Chile", isoCode: "CL" }, { name: "Colombia", isoCode: "CO" },
              { name: "España", isoCode: "ES" }, { name: "Estados Unidos", isoCode: "US" },
              { name: "México", isoCode: "MX" }, { name: "Perú", isoCode: "PE" },
              { name: "Uruguay", isoCode: "UY" }, { name: "Japón", isoCode: "JP" }
            ];
          }
        }

        // Si ya había un país seleccionado (ej. edición), cargarlo
        if (inputCountry.value) {
          const found = state.countries.find(c => c.name.toLowerCase() === inputCountry.value.toLowerCase());
          if (found) selectCountry(found);
        }
        validateForm();

        // Limpiar parámetros URL
        const url = new URL(window.location.href);
        if (url.searchParams.has('success') || url.searchParams.has('error')) {
          url.searchParams.delete('success');
          url.searchParams.delete('error');
          window.history.replaceState({}, document.title, url.pathname);
        }
      });
    </script>
  </body>
</html>