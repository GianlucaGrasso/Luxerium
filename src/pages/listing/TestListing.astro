---
// src/pages/listing/TestListing.astro
export const prerender = false;

import { supabase } from '../../infrastructure/supabase';
import Navbar from '../../ui/navbar/Navbar.astro';
import { MarketFilters } from '../../ui/marketFilter-ui/marketFilters.js';

let message = "";
let messageType = "";

const url = new URL(Astro.request.url);
if (url.searchParams.get("success") === "true") {
  message = "¡Propiedad publicada con éxito!";
  messageType = "success";
} else if (url.searchParams.get("error")) {
  message = "Ocurrió un error al procesar el formulario. Por favor, inténtalo de nuevo.";
  messageType = "error";
}

if (Astro.request.method === "POST") {
  try {
    const contentType = Astro.request.headers.get("content-type") || "";
    if (!contentType.includes("application/x-www-form-urlencoded") && !contentType.includes("multipart/form-data")) {
      throw new Error("Método de envío no válido");
    }

    const formData = await Astro.request.formData();
    
    const country = formData.get("country")?.toString().trim() || null;
    const state = formData.get("state")?.toString().trim() || null;
    const city = formData.get("city")?.toString().trim() || null;
    const neighborhood = formData.get("neighborhood")?.toString().trim() || null;
    const street = formData.get("street")?.toString().trim() || "";
    const height = formData.get("height")?.toString().trim() || "";
    
    let address = "";
    if (street) {
      address = height ? `${street} ${height}` : street;
    } else {
      address = neighborhood || city || "Dirección sin calle";
    }
    
    if (!country || !state || !city) {
      throw new Error("Faltan datos de ubicación esenciales.");
    }

    const postal_code = formData.get("postal_code")?.toString().trim() || null;
    const latitude = formData.get("latitude") ? Number(formData.get("latitude")) : null;
    const longitude = formData.get("longitude") ? Number(formData.get("longitude")) : null;

    const property_type = formData.get("property_type")?.toString() || "";
    const property_subtype = formData.get("property_subtype")?.toString() || null;
    const isLand = property_type === 'land';
    
    const total_area = formData.get("total_area") ? Number(formData.get("total_area")) : null;
    const covered_area = formData.get("covered_area") ? Number(formData.get("covered_area")) : null;
    
    const bedrooms = isLand ? 0 : (formData.get("bedrooms") ? Number(formData.get("bedrooms")) : 0);
    const bathrooms = isLand ? 0 : (formData.get("bathrooms") ? Number(formData.get("bathrooms")) : 0);
    const garage_slots = isLand ? 0 : (formData.get("garage_slots") ? Number(formData.get("garage_slots")) : 0);
    const built_year = formData.get("built_year") ? Number(formData.get("built_year")) : null;
    const orientation = formData.get("orientation")?.toString() || null;
    const floor_number = formData.get("floor_number") ? Number(formData.get("floor_number")) : null;
    const unit_number = formData.get("unit_number")?.toString().trim() || null;

    const status = formData.get("status")?.toString() || "sale";
    const cleanPrice = (val) => {
      if (!val) return null;
      const cleaned = val.replace(/[^\d]/g, '');
      return cleaned ? Number(cleaned) : null;
    };

    const rawPrice = formData.get("price")?.toString() || "";
    const price = (status === "sale" && rawPrice) ? cleanPrice(rawPrice) : null;
    const currency = status === "sale" ? (formData.get("currency")?.toString() || 'USD') : null;
    
    const rawRentalPrice = formData.get("rental_price")?.toString() || "";
    const rental_price = (status === "rent" && rawRentalPrice) ? cleanPrice(rawRentalPrice) : null;
    const rental_currency = status === "rent" ? (formData.get("rental_currency")?.toString() || 'ARS') : null;

    const expenses = formData.get("expenses") ? cleanPrice(formData.get("expenses")?.toString()) : null;

    const amenities = {
      pool_common: formData.get("amenity_pool_common") === "true",
      security: formData.get("amenity_security") === "true",
      gym: formData.get("amenity_gym") === "true",
      sum: formData.get("amenity_sum") === "true",
      laundry: formData.get("amenity_laundry") === "true",
      pool_private: formData.get("amenity_pool_private") === "true",
      garden: formData.get("amenity_garden") === "true",
      grill: formData.get("amenity_grill") === "true",
      jacuzzi: formData.get("amenity_jacuzzi") === "true",
      terrace: formData.get("amenity_terrace") === "true",
      playroom: formData.get("amenity_playroom") === "true"
    };

    const description = formData.get("description")?.toString().trim() || null;
    const primary_agent_id = formData.get("primary_agent_id")?.toString() || null;

    const extraData = {
      images: [],
      model_3d_url: formData.get("model_3d_url")?.toString() || "",
      amenities
    };

    const { error: insertError } = await supabase
      .from('listingsRealEstate')
      .insert([
        {
          country, state, city, neighborhood, address,
          postal_code, latitude, longitude,
          property_type, property_subtype,
          total_area, covered_area,
          bedrooms, bathrooms, garage_slots,
          built_year, orientation,
          floor: floor_number, unit: unit_number,
          price, currency,
          rental_price, rental_currency,
          expenses, status,
          description, primary_agent_id,
          extra: extraData
        }
      ]);

    if (insertError) throw insertError;

    return Astro.redirect(`${url.pathname}?success=true`);

  } catch (error) {
    console.error("❌ Error en backend:", error);
    return Astro.redirect(`${url.pathname}?error=true`);
  }
}

const { data: agents } = await supabase.from('agents').select('id, name');
const realEstateTypes = MarketFilters.realEstate.types;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Luxerium - Panel de Publicación Profesional</title>
  </head>
  <body class="bg-neutral-950 min-h-screen text-neutral-100 font-secondaryFont pb-16">
    <Navbar />

    <main class="max-w-5xl mx-auto p-4 md:p-8 mt-6">
      <!-- Cabecera -->
      <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between border-b border-neutral-900 pb-6">
        <div>
          <span class="text-[9px] bg-secondaryColor/10 text-secondaryColor px-2.5 py-1 rounded-full font-bold uppercase tracking-widest border border-secondaryColor/20">
            Console Engine v6.0 - Global Adaptive Geo Cascade
          </span>
          <h1 class="text-2xl font-black uppercase tracking-wider text-white mt-3">Panel de Publicación de Propiedades</h1>
          <p class="text-xs text-neutral-500 mt-1">Precarga predictiva con soporte adaptativo internacional.</p>
        </div>
      </div>

      {message && (
        <div class={`p-4 rounded-xl text-xs uppercase tracking-wider font-bold mb-8 text-center border shadow-lg transition-all ${messageType === 'success' ? 'bg-Green/10 border-Green/30 text-Green' : 'bg-red-500/10 border-red-500/20 text-red-400'}`}>
          {message}
        </div>
      )}

      <div class="flex flex-wrap gap-2 mb-8 border-b border-neutral-900 pb-4">
        <button type="button" data-target="tab-ubicacion" class="tab-btn px-5 py-3 rounded-xl text-[10px] uppercase font-black tracking-wider transition-all bg-secondaryColor text-white">1. Ubicación Modular</button>
        <button type="button" data-target="tab-caracteristicas" class="tab-btn px-5 py-3 rounded-xl text-[10px] uppercase font-black tracking-wider transition-all bg-neutral-900 text-neutral-400 hover:text-white">2. Características & Áreas</button>
        <button type="button" data-target="tab-precios" class="tab-btn px-5 py-3 rounded-xl text-[10px] uppercase font-black tracking-wider transition-all bg-neutral-900 text-neutral-400 hover:text-white">3. Precios & Amenities</button>
        <button type="button" data-target="tab-estimador" class="tab-btn px-5 py-3 rounded-xl text-[10px] uppercase font-black tracking-wider transition-all bg-neutral-900 text-neutral-400 hover:text-white">4. Estimador & Guardar</button>
      </div>

      <form id="form-listing" action="" method="POST" class="space-y-6">
        
        <!-- ================= TAB 1: UBICACIÓN (componentes internos) ================= -->
        <div id="tab-ubicacion" class="tab-content block space-y-6">
          <section class="bg-neutral-900 border border-neutral-800/80 rounded-2xl p-6 shadow-xl space-y-6">
            <div class="flex items-center gap-3 border-b border-neutral-800/60 pb-4 mb-2">
              <span class="w-7 h-7 bg-Green/10 border border-Green/20 text-Green text-xs rounded-lg flex items-center justify-center font-bold">1</span>
              <h3 class="text-xs font-bold uppercase tracking-widest text-neutral-200">Localización Jerárquica</h3>
            </div>

            <!-- País (CountryInput) -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="relative">
                <label class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">País</label>
                <input 
                  type="text" 
                  id="search-country" 
                  placeholder="Escribí o seleccioná un país..." 
                  class="w-full bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-3.5 py-3 rounded-xl focus:outline-none uppercase font-bold"
                  autocomplete="off"
                />
                <div id="suggest-country" class="hidden absolute left-0 right-0 top-full mt-1 bg-neutral-950 border border-neutral-800 rounded-xl shadow-2xl z-50 max-h-72 overflow-y-auto overscroll-contain divide-y divide-neutral-900"></div>
                <input type="hidden" id="input-country" name="country" />
                <input type="hidden" id="input-country-code" />
                <div id="country-error" class="text-red-400 text-[10px] mt-1 hidden">Seleccioná un país de la lista.</div>
              </div>

              <!-- Estado (StateSelect) -->
              <div class="relative">
                <label id="label-state" class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">Provincia / Estado</label>
                <select 
                  id="select-state" 
                  name="state"
                  disabled
                  class="w-full bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-3.5 py-3.5 rounded-xl focus:outline-none uppercase font-bold disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer"
                >
                  <option value="">Seleccione un País primero...</option>
                </select>
                <div id="state-error" class="text-red-400 text-[10px] mt-1 hidden">No se pudieron cargar los estados.</div>
              </div>

              <!-- Ciudad (CitySelect) -->
              <div class="relative">
                <label id="label-city" class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">Ciudad / Localidad</label>
                <select 
                  id="select-city" 
                  name="city"
                  disabled
                  class="w-full bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-3.5 py-3.5 rounded-xl focus:outline-none uppercase font-bold disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer"
                >
                  <option value="">Seleccione una Provincia primero...</option>
                </select>
                <div id="city-error" class="text-red-400 text-[10px] mt-1 hidden">No se pudieron cargar las ciudades.</div>
              </div>
            </div>

            <!-- Barrio y Estación (NeighborhoodAndStation) -->
            <div id="wrapper-neighborhood-section" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-neutral-800/40">
              <div class="relative">
                <label id="label-neighborhood" class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">Barrio / Comuna</label>
                <input 
                  type="text" 
                  id="search-neighborhood" 
                  placeholder="Ej: Palermo / Shibuya..." 
                  class="w-full bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-3.5 py-3 rounded-xl focus:outline-none uppercase font-bold"
                  autocomplete="off"
                />
                <div id="suggest-neighborhood" class="hidden absolute left-0 right-0 top-full mt-1 bg-neutral-950 border border-neutral-800 rounded-xl shadow-2xl z-50 max-h-40 overflow-y-auto divide-y divide-neutral-900"></div>
                <input type="hidden" id="input-neighborhood" name="neighborhood" />
              </div>
              <div id="wrapper-subway-station" class="relative hidden">
                <label class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">Estación de Tren / Subte</label>
                <input 
                  type="text" 
                  id="search-station" 
                  placeholder="Ej: Shinjuku Station..." 
                  class="w-full bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-3.5 py-3 rounded-xl focus:outline-none uppercase font-bold"
                  autocomplete="off"
                />
                <div id="suggest-station" class="hidden absolute left-0 right-0 top-full mt-1 bg-neutral-950 border border-neutral-800 rounded-xl shadow-2xl z-50 max-h-40 overflow-y-auto divide-y divide-neutral-900"></div>
                <input type="hidden" id="input-station" />
              </div>
            </div>

            <!-- Calle y Altura (StreetAndHeight) -->
            <div id="wrapper-street-section" class="hidden grid grid-cols-1 sm:grid-cols-4 gap-4 pt-4 border-t border-neutral-800/40">
              <div class="relative sm:col-span-3">
                <label id="label-street" class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">Calle / Avenida / Bloque</label>
                <input 
                  type="text" 
                  id="search-street" 
                  placeholder="Ej: Felipe Vallese..." 
                  class="w-full bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-3.5 py-3 rounded-xl focus:outline-none uppercase font-bold"
                  autocomplete="off"
                />
                <div id="suggest-street" class="hidden absolute left-0 right-0 top-full mt-1 bg-neutral-950 border border-neutral-800 rounded-xl shadow-2xl z-50 max-h-40 overflow-y-auto divide-y divide-neutral-900"></div>
                <input type="hidden" id="input-street" name="street" />
              </div>
              <div>
                <label id="label-height" class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">Altura / Número</label>
                <input 
                  type="text" 
                  id="input-height" 
                  name="height" 
                  placeholder="Ej: 761" 
                  class="w-full bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-3.5 py-3 rounded-xl focus:outline-none uppercase font-bold"
                />
              </div>
            </div>

            <!-- Previsualización (LocationPreview) -->
            <div id="address-preview-card" class="hidden bg-neutral-950 border border-neutral-800 p-5 rounded-2xl">
              <span class="text-[9px] uppercase tracking-widest font-black text-secondaryColor block mb-2">📍 Ficha de Ubicación Validada</span>
              <div class="space-y-1.5">
                <p id="preview-address" class="text-base font-black text-white tracking-wide"></p>
                <p id="preview-details" class="text-[10px] text-neutral-400 uppercase font-semibold tracking-wider"></p>
              </div>
            </div>

            <input type="hidden" id="input-postal" name="postal_code" />
            <input type="hidden" id="input-latitude" name="latitude" />
            <input type="hidden" id="input-longitude" name="longitude" />
          </section>
        </div>

        <!-- ================= TAB 2: CARACTERÍSTICAS ================= -->
        <div id="tab-caracteristicas" class="tab-content hidden space-y-6">
          <section class="bg-neutral-900 border border-neutral-800/80 rounded-2xl p-6 shadow-xl">
            <div class="flex items-center gap-3 border-b border-neutral-800/60 pb-4 mb-5">
              <span class="w-7 h-7 bg-secondaryColor/10 border border-secondaryColor/20 text-secondaryColor text-xs rounded-lg flex items-center justify-center font-bold">2</span>
              <h3 class="text-xs font-bold uppercase tracking-widest text-neutral-200">Tipología e Información Física</h3>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
              <div>
                <label class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">Tipo de Propiedad</label>
                <select id="select-property-type" name="property_type" class="w-full bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-3.5 py-3.5 rounded-xl focus:outline-none uppercase font-bold cursor-pointer">
                  <option value="">Seleccionar Tipo...</option>
                  {Object.entries(realEstateTypes).map(([key, value]) => (
                    <option value={key}>{value.title}</option>
                  ))}
                </select>
                <div id="type-error" class="text-red-400 text-[10px] mt-1 hidden">Seleccioná un tipo de propiedad.</div>
              </div>
              <div>
                <label class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">Subtipo Oficial</label>
                <select id="select-property-subtype" name="property_subtype" class="w-full bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-3.5 py-3.5 rounded-xl focus:outline-none uppercase font-bold disabled:opacity-30 disabled:cursor-not-allowed" disabled>
                  <option value="">Seleccione el tipo primero...</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
              <div>
                <label class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">M² Totales</label>
                <input type="number" step="any" id="total_area" name="total_area" placeholder="250" class="w-full bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-3.5 py-3.5 rounded-xl focus:outline-none" />
                <div id="area-error" class="text-red-400 text-[10px] mt-1 hidden">Ingresá un área válida.</div>
              </div>
              <div>
                <label class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">M² Cubiertos</label>
                <input type="number" step="any" id="covered_area" name="covered_area" placeholder="180" class="w-full bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-3.5 py-3.5 rounded-xl focus:outline-none" />
              </div>
              <div>
                <label class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">Año de Const.</label>
                <input type="number" name="built_year" placeholder="2020" class="w-full bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-3.5 py-3.5 rounded-xl focus:outline-none" />
              </div>
              <div>
                <label class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">Orientación</label>
                <select id="select-orientation" name="orientation" class="w-full bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-3.5 py-3.5 rounded-xl focus:outline-none uppercase font-bold">
                  <option value="">No Especificar</option>
                  <option value="norte">Norte</option>
                  <option value="sur">Sur</option>
                  <option value="este">Este</option>
                  <option value="oeste">Oeste</option>
                </select>
              </div>
            </div>

            <div id="unit-spec-section" class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-neutral-800/40 mb-6">
              <div>
                <label class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">Nº de Piso</label>
                <input type="number" id="input-floor" name="floor_number" placeholder="4" class="w-full bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-3.5 py-3.5 rounded-xl" />
              </div>
              <div>
                <label class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">Nº de Unidad</label>
                <input type="text" id="input-unit" name="unit_number" placeholder="B" class="w-full bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-3.5 py-3.5 rounded-xl uppercase" />
              </div>
            </div>

            <div id="residential-specs" class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-neutral-800/40">
              <div>
                <label class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">Habitaciones</label>
                <input type="number" id="input-bedrooms" name="bedrooms" placeholder="3" class="w-full bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-3.5 py-3.5 rounded-xl focus:outline-none" />
              </div>
              <div>
                <label class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">Baños</label>
                <input type="number" id="input-bathrooms" name="bathrooms" placeholder="2" class="w-full bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-3.5 py-3.5 rounded-xl focus:outline-none" />
              </div>
              <div>
                <label class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">Cocheras</label>
                <input type="number" id="input-garage" name="garage_slots" placeholder="1" class="w-full bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-3.5 py-3.5 rounded-xl focus:outline-none" />
              </div>
            </div>
          </section>
        </div>

        <!-- ================= TAB 3: PRECIOS Y AMENITIES ================= -->
        <div id="tab-precios" class="tab-content hidden space-y-6">
          <section class="bg-neutral-900 border border-neutral-800/80 rounded-2xl p-6 shadow-xl">
            <div class="flex items-center gap-3 border-b border-neutral-800/60 pb-4 mb-5">
              <span class="w-7 h-7 bg-neutral-850 border border-neutral-700 text-neutral-300 text-xs rounded-lg flex items-center justify-center font-bold">3</span>
              <h3 class="text-xs font-bold uppercase tracking-widest text-neutral-200">Operación Comercial y Valores</h3>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-5">
              <div>
                <label class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">Tipo de Operación</label>
                <select id="select-status" name="status" class="w-full bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-3.5 py-3.5 rounded-xl focus:outline-none uppercase font-bold cursor-pointer">
                  <option value="sale">Venta</option>
                  <option value="rent">Alquiler</option>
                </select>
              </div>
              <div>
                <label class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">Expensas Mensuales</label>
                <input type="text" id="input-expenses" name="expenses" placeholder="85.000" class="money-format w-full bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-3.5 py-3.5 rounded-xl focus:outline-none" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-neutral-950/40 p-4 rounded-xl border border-neutral-800/40 mb-8">
              <div id="box-sale" class="transition-all duration-300">
                <label class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">Valor Total de Venta</label>
                <div class="flex gap-2">
                  <input type="text" id="input-price" name="price" placeholder="450.000" class="money-format flex-1 bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-4 py-3.5 rounded-xl focus:outline-none" />
                  <select name="currency" class="w-24 text-center bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs py-3.5 rounded-xl focus:outline-none font-bold cursor-pointer">
                    <option value="USD">USD ($)</option>
                    <option value="EUR">EUR (€)</option>
                    <option value="ARS">ARS ($)</option>
                    <option value="BRL">BRL (R$)</option>
                    <option value="UYU">UYU ($)</option>
                  </select>
                </div>
                <div id="price-error" class="text-red-400 text-[10px] mt-1 hidden">Ingresá un precio de venta válido.</div>
              </div>

              <div id="box-rent" class="transition-all duration-300 opacity-40">
                <label class="block text-[10px] uppercase tracking-wider font-bold text-neutral-400 mb-2">Valor Alquiler Mensual</label>
                <div class="flex gap-2">
                  <input type="text" id="input-rental-price" name="rental_price" disabled placeholder="1.200" class="money-format flex-1 bg-neutral-950 border border-neutral-800 text-neutral-200 text-xs px-4 py-3.5 rounded-xl focus:outline-none disabled:cursor-not-allowed" />
