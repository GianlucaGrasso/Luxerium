---
import Layout from '../layouts/Layout.astro';
import Navbar from '../ui/navbar/Navbar.astro';
import SecondaryNavbar from '../ui/navbar/SecondaryNavbar.astro';
import Feature from '../ui/indexComponents/Feature.astro';
import Markets from  '../ui/indexComponents/Markets.astro';
import Test2 from '../playground/test2.astro';
import Footer from '../ui/Footer.astro';
---

<Layout title="Luxerium">
    <Navbar />
    <SecondaryNavbar/>
    <Feature />
    <div class="flex flex-col">
        <div class="w-full">
            <Markets client:load />
        </div>
    </div>
</Layout>

    
<style is:global>
	@font-face {
        font-family: 'primaryFont';
        src: url('/luxerium-app/public/fonts/archivo.ttf') format('truetype');
    }
    @font-face {
        font-family: 'secondaryFont';
        src: url('/luxerium-app/public/fonts/genera-grotesk.ttf') format('truetype');
    }
</style>

