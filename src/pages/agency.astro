---

// Core
import Layout from "../shared/presentation/layouts/Layout.astro";
import Navbar from "../shared/presentation/components/layout/navbar/Navbar.astro";
import SecondaryNavbar from "../shared/presentation/components/layout/navbar/SecondaryNavbar.astro";
import SecondaryAnchor from "../shared/presentation/components/layout/navbar/components/SecondaryAnchor.astro";

// Agency Components
import BannerAgency from "../components/subComponents/agency/BannerAgency.astro";
import InfoAgency from "../components/subComponents/agency/InfoAgency.astro";

// Global Listings filtered by agency
import RealestateCard from "../features/real-estate/presentation/components/RealestateCard.jsx";
