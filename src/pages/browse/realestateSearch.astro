---
//REALESTATE SEARCH PAGE
import Layout from "../../layouts/Layout.astro"
import Navbar from "../../ui/navbar/Navbar.astro"
import SecondaryNavbar from "../../ui/navbar/SecondaryNavbar.astro"
import MapView from "../../ui/map/MapView"
import Proplist from "../../ui/real-estate/Proplist"
import Filters from "../../playground/playground-components/Filters.astro" //*ESTO ES UN FILTRO DE PRUEBA*//



---

<Layout title="Real Estate">
    <Navbar />
    <SecondaryNavbar />
    <Filters/>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-0 h-[82.5dvh] static">
        <MapView client:only="react" />
        <Proplist client:only="react" />
    </div>
</Layout>



