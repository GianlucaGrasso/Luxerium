// https://cdn.pixabay.com/video/2019/10/09/27669-365224683_large.mp4"

---
<script>
    const welcomes = [
      "Welcome to Luxerium",
      "Explore the Luxury Realm",
      "Indulge in Luxury",
      "Discover Luxerium",
    ];
  
    function getRandomWelcome() {
      return welcomes[Math.floor(Math.random() * welcomes.length)];
    }
  
    document.addEventListener('DOMContentLoaded', () => {
      const welcomeTextElement = document.getElementById('WelcomeText');
      if (welcomeTextElement) {
        // Establece el primer mensaje inmediatamente
        welcomeTextElement.textContent = getRandomWelcome();
  
        // Luego cada 2 segundos (ajusta el tiempo a tu gusto)
        setInterval(() => {
          welcomeTextElement.textContent = getRandomWelcome();
        }, 2000);
      }
    });
</script>
  

<Layout title="Luxerium - User Login">
    <Navbar />
    <SecondaryNavbar />
    <div>
        <!-- 
            
        <iframe width="2160" height="1080" src="https://www.youtube.com/embed/s8ctjBfWHBk"  allow="muted;accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" class="absolute w-full h-full object-cover -z-50"></iframe>
        
        -->
        <video src="https://videos.pexels.com/video-files/3129902/3129902-uhd_2560_1440_25fps.mp4" autoplay muted loop class="absolute w-full h-full object-cover -z-50 blur-[0.5px] brightness-125 saturate-[0.75] ">
    </div>
    <h1 class="w-fit m-auto font-secondaryFont text-4xl text-primaryColor font-black  pt-14 uppercase" id="WelcomeText"> Welcome to Luxerium </h1>
    <div class="flex flex-col items-center justify-center w-full m-auto  mt-14 ">
        <div class=" outline outline-1 outline-secondaryColor p-8 rounded-xl shadow-md w-full max-w-md bg-terciaryColor">
            <img src="/icons/brand/faviconLuxerium.svg" alt="" class="h-16 mx-auto mb-4">
            <div class="grid grid-cols-2 gap-10 w-fit m-auto  my-6">
                <button class="bg-transparent px-6 py-1 rounded-md font-secondaryFont text-primaryColor outline outline-1 outline-secondaryColor transition ease-linear duration-300 focus:bg-secondaryColor focus:text-terciaryColor">LOGIN</button>
                <button class="bg-transparent px-6 py-1 rounded-md font-secondaryFont text-primaryColor outline outline-1 outline-secondaryColor transition ease-linear duration-300 focus:bg-secondaryColor focus:text-terciaryColor">REGISTER</button>
            </div>
            <form>
                <div class="mb-4">
                    <label for="username" class="block text-sm font-secondaryFont text-primaryColor mx-auto w-fit"></label>
                    <input type="text" id="username" name="username" placeholder="USERNAME" required
                        class="mt-1 block w-full px-3 py-2 border rounded-md shadow-sm sm:text-sm font-secondaryFont uppercase placeholder:font-secondaryFont">
                </div>
                <div class="mb-6">
                    <label for="password" class="block text-sm font-medium text-gray-700"></label>
                    <input type="password" id="password" name="password" placeholder="PASSWORD" required
                        class="mt-1 block w-full px-3 py-2 border rounded-md shadow-sm sm:text-sm font-secondaryFont placeholder:font-secondaryFont">
                </div>
                <button type="submit"
                    class="w-full outline outline-1 outline-secondaryColor bg-transparent hover:bg-secondaryColor text-primaryColor font-secondaryFont py-2 px-4 rounded transition  uppercase">LOGIN</button>
            </form>
            <p class="mt-4 font-secondaryFont text-primaryColor/50 text-xs">Forgot your password?  <a href="#" class="text-primaryColor"> Click Here to recover it! </a></p>
        </div>
        
    </div>
    


</Layout>