---
import Layout from "../../layouts/Layout.astro";
import Feature from "../../ui/indexComponents/Feature.astro";
import Navbar from "../../ui/navbar/Navbar.astro";
import SecondaryNavbar from "../../ui/navbar/SecondaryNavbar.astro";
import Proplist from "../../ui/real-estate/Proplist";

// src/pages/place/[...place].astro
export const prerender = false; // SSR para rutas dinámicas

const placeParam = Astro.params.place;
const place = placeParam 
  ? (Array.isArray(placeParam) ? placeParam : [placeParam]) 
  : [];

const slugPath = place.join('/');

// Obtener nombre legible del último segmento
const placeName = place.length > 0 
  ? place[place.length - 1].replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase())
  : 'Select a location';

// Breadcrumbs con rutas acumulativas
const breadcrumbs = place.map((seg, idx) => {
  const path = place.slice(0, idx + 1).join('/');
  const label = seg.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
  return { label, path };
});

// Fetch básico a Nominatim para obtener coordenadas y datos extra
let locationDetails = null;
if (place.length > 0) {
  try {
    const query = place.map(p => p.replace(/-/g, ' ')).join(', ');
    const url = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(query)}&format=json&addressdetails=1&limit=1&accept-language=en`;
    const res = await fetch(url, { headers: { 'User-Agent': 'LuxeriumApp/1.0' } });
    const data = await res.json();
    if (data && data.length > 0) {
      locationDetails = {
        displayName: data[0].display_name,
        lat: data[0].lat,
        lon: data[0].lon,
        type: data[0].type,
        address: data[0].address
      };
    }
  } catch(e) {
    // Silencioso
  }
}
