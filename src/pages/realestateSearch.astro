---
import Layout from "../layouts/Layout.astro"
import Navbar from "../components/core/Navbar.astro"
import SecondaryNavbar from "../components/core/SecondaryNavbar.astro"
import MapView from "../components/core/map/MapView.jsx"
import Proplist from "../components/Proplist.jsx"
import Filters from "../components/subComponents/navbarElements/Filters.astro"



---

<Layout title="Real Estate">
    <Navbar />
    <SecondaryNavbar />
    <Filters/>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-0 h-[82.5dvh] static">
        <MapView client:only="react" />
        <Proplist client:only="react" />
    </div>
</Layout>



  


