---

import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;



---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/icons/brand/favicon.svg" />
		<link rel="stylesheet" href="">
		<title>{title}</title>
	</head>
	<body class="bg-terciaryColor bg-fixed no-scrollbar m-0 p-0 box-border">
		<slot />
		<!-- FOOTER 
		<div class="static bottom-0 w-full py-4 border-t border-primaryColor bg-terciaryColor" >
			<div class="w-fit m-auto">
				<img src="../icons/brand/faviconLuxerium.svg" alt="" class="m-auto h-16">
				<p class=" font-secondaryFont text-secondaryColor text-md font-bold">LUXERIUM &copy; 2025. All rights reserved.</p>
			</div>
			<p class="font-secondaryFont text-secondaryColor text-xs font-bold ml-[2em]">FOR SUPPORT PLEASE CONTACT: <a href="support@luxerium.com">support@luxerium.com</a></p>
		</div>
		-->
	</body>
</html>

<style is:global>
	:root{
		--lgb: hsla(0, 0%, 37%, 0.3);
		--lgg: hsla(40, 74%, 10%, 0.6);
	}
</style>

<script>
	document.addEventListener('scroll', () => {
	  const mainNav = document.getElementById('main-nav');
	  const secondaryNav = document.getElementById('secondary-nav');
	  const isScrolled = window.scrollY > 0;
  
	  // Función para aplicar o quitar las clases
	  const toggleBackground = (element) => {
		if (!element) return;
		if (isScrolled) {
		  element.classList.add('bg-terciaryColor');
		  element.classList.remove('bg-transparent');
		} else {
		  element.classList.remove('bg-terciaryColor');
		  element.classList.add('bg-transparent');
		}
	  };
  
	  toggleBackground(mainNav);
	  toggleBackground(secondaryNav);
	});
  </script>