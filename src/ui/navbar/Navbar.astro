---
import Logotype from "./components/Logotype.astro";
import HamburgerMenu from "./components/HamburgerMenu.astro";
import UserButton from "./components/UserButton.astro";
import ListWithUs from "./components/ListWithUs.astro";

---

<header id="main-nav" class="bg-transparent border-b border-primaryColor/50 text-primaryColor sticky top-0 z-50 font-semibold h-[60px] w-full transition-colors duration-100">
  <div class="flex items-center justify-between w-full h-full px-8">
    <!-- Menú hamburguesa y "List With Us" a la izquierda -->
    <div class="flex items-center">
      <HamburgerMenu />
    </div>
    
    <!-- Logotipo centrado -->
    <div class="absolute left-1/2 transform -translate-x-1/2">
      <Logotype />
    </div>
    
    <!-- Botón de usuario a la derecha -->
    <div class="flex items-center">
      <div class="pr-6 md:inline hidden">
        <ListWithUs/>
      </div>

      <div class="sm:inline hidden">
        <UserButton />
      </div>
    </div>
  </div>
</header>
