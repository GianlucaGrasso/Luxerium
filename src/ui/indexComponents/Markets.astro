---
import BrowseBy from "./BrowseBy.astro"
import { MarketFilters } from "../marketFilter-ui/marketFilters"
import react from "@astrojs/react"

const getNestedTypes = (
  obj: Record<string, any>,
  maxDepth: number = 3,
  currentDepth: number = 1
): any[] => {
  if (currentDepth > maxDepth) return [];

  return Object.values(obj).flatMap(value => {
    if (!value?.types) return [];

    const typesArray = Object.values(value.types);
    const currentResults = currentDepth >= 2 ? typesArray : [];
    
    const nestedResults = getNestedTypes(
      value.types,
      maxDepth,
      currentDepth + 1
    );

    return [...currentResults, ...nestedResults];
  });
};

const allTypes = getNestedTypes(MarketFilters, 3);
---

<div class="max-w-[100vw] flex flex-col relative">

  <!-- START sentinel: marca el inicio de la sección Markets -->
  <section id="markets" class="w-full">
    <div id="markets-start" class="w-full h-1"></div>

    <h1 class="text-center w-fit m-auto mt-[.75em] text-primaryColor font-secondaryFont text-[18px] pt-3">
      BROWSE BY MARKETPLACE
    </h1>
    
    <div class="my-[1.5em] w-full flex md:grid-cols-2 justify-center px-[2em] gap-[10px]">
      {
        Object.values(MarketFilters).map((filter) => {
          return (
            <BrowseBy 
              title={filter.title.toUpperCase()} 
              size="md" 
              image={filter.image}
            />
          )
        })
      }
    </div>
  </section>

  <div class="max-w-[100vw] flex flex-col">
    <h1 class="text-center w-fit m-auto text-primaryColor font-secondaryFont text-[18px]">BROWSE BY TYPE</h1>
    
    <div class="my-[1.5em] w-full grid px-[2em] gap-[10px] grid-cols-1 md:grid-cols-3 lg:grid-cols-4">
      {
        Object.values({ ...MarketFilters.realEstate.types, ...MarketFilters.vehicles.types}).map((filter) => {
          return (
            <BrowseBy 
              title={filter.title.toUpperCase()} 
              size="sm" 
              image={filter.image} 
            />
          )
        })
      }

      {
        allTypes.map((type) => {
          return (
            <BrowseBy 
              title={type.title.toUpperCase()} 
              size="sm" 
              image={type.image} 
            />
          )
        })
      }
    </div>
  </div>

  <!-- END sentinel: marca el final de la sección Markets -->
  <div id="markets-end" class="w-full h-1"></div>

  <!-- WRAPPER del botón: inicialmente oculto (Status 0) -->
  <div
    id="search-all-wrapper"
    class="w-full px-8 z-50 pointer-events-none opacity-0 -translate-y-3 transition-all duration-300 ease-in-out"
    aria-hidden="true"
  >
    <button
      id="search-all-btn"
      class="text-center font-secondaryFont w-full m-auto py-3 rounded-none text-terciaryColor"
      type="button"
    >
      SEARCH ALL [ ... ]
    </button>
  </div>
</div>

<script type="module">
  const wrapper = document.getElementById('search-all-wrapper');
  const btn = document.getElementById('search-all-btn');
  const startSentinel = document.getElementById('markets-start');
  const endSentinel = document.getElementById('markets-end');

  if (wrapper && startSentinel && endSentinel) {
    // Flags de estado
    let startIsIntersecting = true; // true cuando el inicio está visible (usuario en top)
    let atBottom = false;           // true cuando el final está visible (estado final)
    let isVisible = false;          // true cuando el wrapper está visible (Status 1 o Final)

    // Clases Tailwind
    // Estado semi-visible (Status 1): borde secondaryColor, fondo terciaryColor/50, texto primaryColor
    const semiVisibleClasses = [
      'fixed','bottom-0','left-0','right-0',
      'border-2','border-secondaryColor',
      'bg-terciaryColor/50','backdrop-blur-sm',
      'pb-[env(safe-area-inset-bottom)]','shadow-lg'
    ];
    // Estado final (estático y claro)
    const staticClasses = [
      'static','bg-primaryColor','backdrop-blur-none','shadow-none'
    ];

    // Helpers para mostrar/ocultar con transiciones
    function applyVisible() {
      wrapper.setAttribute('aria-hidden', 'false');
      wrapper.classList.remove('pointer-events-none','opacity-0','translate-y-4');
      wrapper.classList.add('pointer-events-auto','opacity-100','translate-y-0');
      isVisible = true;
    }
    function applyHidden() {
      wrapper.setAttribute('aria-hidden', 'true');
      wrapper.classList.remove('pointer-events-auto','opacity-100','translate-y-0');
      wrapper.classList.add('pointer-events-none','opacity-0','translate-y-4');
      isVisible = false;
    }

    // Status 1: fixed + blur + border + terciary bg (aparece cuando el usuario scrollea dentro de la sección)
    function showSemiVisible() {
      if (atBottom) return; // si estamos en final, no aplicar
      applyVisible();

      // Quitar estado estático si existía
      wrapper.classList.remove(...staticClasses);

      // Quitar cualquier clase previa de semiVisible para evitar duplicados
      wrapper.classList.remove(...semiVisibleClasses);
      // Aplicar semi-visible
      wrapper.classList.add(...semiVisibleClasses);

      // Botón: texto primaryColor
      btn.classList.remove('text-terciaryColor');
      btn.classList.add('text-primaryColor');
    }

    // Status Final: estático y claro (cuando el final entra en viewport)
    function makeStaticClear() {
      atBottom = true;
      applyVisible();

      // Quitar semi-visible y aplicar estático
      wrapper.classList.remove(...semiVisibleClasses);
      wrapper.classList.add(...staticClasses);

      // Forzar posición estática para que ocupe flujo normal
      wrapper.style.position = 'static';

      // Botón: texto terciaryColor (contraste con bg-primaryColor)
      btn.classList.remove('text-primaryColor');
      btn.classList.add('text-terciaryColor');

      // Quitar borde si quedó
      wrapper.classList.remove('border-2','border-secondaryColor');
    }

    // Revertir del estado final al anterior (cuando el final deja de intersectar)
    function unsetStatic() {
      if (!atBottom) return;
      atBottom = false;
      wrapper.classList.remove(...staticClasses);
      wrapper.style.position = '';

      // Volver al comportamiento según si el inicio está visible o no
      if (startIsIntersecting) {
        // Si el inicio es visible -> oculto (Status 0)
        applyHidden();
      } else {
        // Si el inicio no es visible -> mostrar semi-visible (Status 1)
        showSemiVisible();
      }
    }

    // Observer para el inicio: controla oculto <-> semi-visible
    const startObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        startIsIntersecting = entry.isIntersecting;

        if (entry.isIntersecting) {
          // Usuario en la parte superior -> ocultar (Status 0)
          applyHidden();
        } else {
          // Usuario scrollea hacia abajo -> mostrar semi-visible (Status 1) salvo que estemos en final
          if (!atBottom) showSemiVisible();
        }
      });
    }, { root: null, threshold: 0.05 });

    // Observer para el final: controla transición a estado final y reversibilidad
    const endObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          // Llegamos al final -> estado final (estático y claro)
          makeStaticClear();
        } else {
          // Salimos del final -> volver al estado anterior (reversible)
          unsetStatic();
        }
      });
    }, { root: null, threshold: 0.05 });

    // Iniciar observadores
    startObserver.observe(startSentinel);
    endObserver.observe(endSentinel);

    // Escape para ocultar (opcional)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        applyHidden();
      }
    });
  }
</script>
