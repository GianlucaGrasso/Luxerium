---
import SecondaryAnchor from "./components/SecondaryAnchor.astro"

---

<header class="w-full py-[10px] bg-terciaryColor border-primaryColor border-y top-[60px] sticky z-50">
    <div class="flex justify-center">
      <nav>
        <ul class="grid grid-cols-2 sm:grid-cols-2 gap-x-16 gap-y-2 sm:gap-x-12 md:gap-x-24 lg:gap-x-44 xl:gap-x-52 2xl:gap-x-[26rem]">
            <SecondaryAnchor market="REAL ESTATE" url="browse/realestateSearch"/>
            <SecondaryAnchor market="VEHICLES" />
        </ul>
      </nav>
    </div>
  </header>
  
  <!-- grid grid-cols-2 sm:grid-cols-4 gap-x-16 gap-y-2 sm:gap-x-12 md:gap-x-24 lg:gap-x-44 xl:gap-x-52 2xl:gap-x-64 IF ADD SHIPS AND AIRCRAFTS -->