---
const { title = "DEFAULT TITLE", image = "https://placehold.co/1920x1080" } = Astro.props;

const { size = "sm" } = Astro.props as { size?: "sm" | "md" | "lg" }; 

var basisSizes = {
  sm: 'col-span-1',
  md: 'col-span-2',
  lg: 'col-span-3',
};

const navigator = '/browse/realestateSearch';

// Corregir Navigator -> Browse dependiendo del titulo ya que si es VEHICLES debe ir a /browse/vehicleSearch etc. 
// Actualmente esta hardcodeado a realestateSearch incluso para los subtipos de real estate y vehicles

---

<button 
  class={`group flex-grow ${basisSizes[size]} h-[15em] w-full duration-[0.3s] ease-in-out bg-top bg-cover relative hover:bg-bottom hover:outline hover:outline-2 hover:outline-secondaryColor hover:shadow-inner hover:shadow-secondaryColor`} 
  style={`background-image: url('${image}');`}
>
  <div class="bg-lightGreyFade w-full h-[3em] absolute bottom-0 flex justify-center items-center group-hover:h-full transition-all duration-300 ease-in-out backdrop-blur-sm">
    <a href=`${navigator}` class="text-primaryColor font-primaryFont text-[1.26rem] tracking-[0.2em] transition-all duration-300 ease-in-out hover:text-secondaryColor ">
      {title}
    </a>
  </div>
</button>
