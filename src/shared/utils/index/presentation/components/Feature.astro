---
import Searchbar from '../../../../../features/search/presentation/components/Searchbar.astro';

var currency = {
  0: 'USD $',
  1: 'EUR €',
  2: 'GBP €',
  3: 'ARS $',
  4: 'JPY ¥',
  5: 'CNY ¥',
  6: 'AUD $',
} ; // Define the currency variable


---

<div class="relative w-full h-[50vh]">
  <Searchbar />
  
  <!-- Image with gradient overlay -->
  <a href="/agency">
    <div class="relative w-full h-full">
      <img 
        src="Featured.webp" 
        alt="Mansion in Lomas de Zamora" 
        class="w-full h-full object-cover hover:object-top" 
        loading="eager"
      />
      
      <!-- Gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>
    </div>
  </a>

  <!-- Text content with better visibility due to gradient -->
  <div class="absolute bottom-0 left-8 mb-8 font-semibold text-primaryColor">
    <h1 class="text-2xl font-secondaryFont">
      MANSION IN LOMAS DE ZAMORA
      <span class="md:inline hidden">, GBA SUR</span>
      <span class="lg:inline hidden">, AR</span>
    </h1>
    <p class="mb-[.5em] text-lg font-secondaryFont">
     <span class="text-secondaryColor font-extrabold">{currency[4]}</span> 420,000,000
    </p>
    <div class="flex space-x-4">
      <button class="transition-all duration-300 backdrop-blur-sm hover:bg-secondaryColor w-72 h-10 text-center border-secondaryColor border rounded-br-3xl rounded-tr-md">
        CONTACT AGENT
      </button>
    </div>
  </div>
</div>

