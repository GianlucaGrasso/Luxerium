    <div class="flex justify-center">
      <nav>
        <ul class="grid grid-cols-2 sm:grid-cols-4 gap-x-16 gap-y-2 sm:gap-x-12 md:gap-x-24 lg:gap-x-44 xl:gap-x-52 2xl:gap-x-64">
            <SecondaryAnchor market="REAL ESTATE" url="realestateSearch"/>
            <SecondaryAnchor market="VEHICLES" />
            <SecondaryAnchor market="AIRCRAFTS" />
            <SecondaryAnchor market="SHIPS" />
        </ul>
      </nav>
    </div>
  </header>
  