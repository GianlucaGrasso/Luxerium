<div class="max-w-[100vw] flex flex-col">
  <h1 class="text-center w-fit m-auto text-primaryColor font-secondaryFont text-[18px]">BROWSE BY TYPE</h1>
  
  <div class="my-[1.5em] w-full grid px-[2em] gap-[10px] grid-cols-1 md:grid-cols-3 lg:grid-cols-4">  
    {
      Object.values({ ...MarketFilters.realEstate.types, ...MarketFilters.vehicles.types, ...MarketFilters.aircrafts.types, ...MarketFilters.ships.types}).map((filter) => {
        return (
          <BrowseBy 
            title={filter.title.toUpperCase()} 
            size="sm" 
            image={filter.image} 
          />
        )
      })
    }

    {
      allTypes.map((type) => {
        return (
          <BrowseBy 
            title={type.title.toUpperCase()} 
            size="sm" 
            image={type.image} 
          />
        )
      })
    }

