---
import BrowseBy from "./subComponents/BrowseBy.astro"
import { MarketFilters } from "../content/marketFilters"
import react from "@astrojs/react"

const getNestedTypes = (
  obj: Record<string, any>,
  maxDepth: number = 3,
  currentDepth: number = 1
): any[] => {
  if (currentDepth > maxDepth) return [];

  return Object.values(obj).flatMap(value => {
    if (!value?.types) return [];

    const typesArray = Object.values(value.types);
    const currentResults = currentDepth >= 2 ? typesArray : [];
    
    const nestedResults = getNestedTypes(
      value.types,
      maxDepth,
      currentDepth + 1
    );

    return [...currentResults, ...nestedResults];
  });
};

const allTypes = getNestedTypes(MarketFilters, 3);


---

<div class="max-w-[100vw] flex flex-col">
  <h1 class="text-center w-fit m-auto mt-[.75em] text-primaryColor font-secondaryFont text-[18px] pt-3">BROWSE BY MARKETPLACE</h1>
  
  <div class="my-[1.5em] w-full grid grid-cols-1 md:grid-cols-4 lg:grid-cols-8 justify-center px-[2em] gap-[10px]">

    {
      Object.values(MarketFilters).map((filter) => {
        return (
          <BrowseBy 
            title={filter.title.toUpperCase()} 
            size="md" 
            image={filter.image} 
          />
        )
      })
    }

