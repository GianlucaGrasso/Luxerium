---
import { number, string } from "astro:schema";
import { idText } from "typescript";


/*
export interface Props {
  id: number;
  slug: string;
  price: string;
  extra?: string;
  location: {
    country: string;
    state: string;
    city: string;
    address: string;
    zipcode: string;
    pluscode?: string;
  };
  status: 0 | 1 | 2 | 3 | 4;
  features: {
    type: string;
    area: string;
    year: number;
    bedrooms: number;
    bathrooms: number;
    slots: number;
  };
  description?: string;
  tags?: string[];
  amenities?: string[];
  agency: string;
  agentName: [string, string];
  media: string[];
}

const {
  id,
  slug,
  price,
  extra,
  location,
  status,
  features,
  description,
  tags,
  amenities,
  agency,
  agentName,
  media
} = Astro.props;
*/

const statusLabel = {
  0: "NO STATE",
  1: "FOR SALE",
  2: "FOR RENT",
  3: "SOLD",
  4: "TEMPO"
} as const;

const statusStyles = {
  0: "text-slate-500 bg-slate-500",
  1: "text-forSale bg-forSale",
  2: "text-forRent bg-forRent",
  3: "text-Sold bg-Sold",
  4: "text-forRentTemp bg-forRentTemp"
} as const;

const listing : {
  id: string;
  slug: string;
  price: number;
  extra: number;
  location_address: string;
  location_city: string;
  location_state: string;
  location_country: string;
  status: number;
  features_type: string;
  features_area: string;
  features_year: number;
  features_bedrooms: number;
  features_bathrooms: number;
  features_slots: number;
  agency: string;
  agentName_1: string;
  agentName_2: string;
  media: string;
  agentImage: string;
} = Astro.props;

function formatPrice(price: number): string {
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: 0,
    maximumFractionDigits: 0
  }).format(price);
}

function formatExtra(extra: number): string {
  return new Intl.NumberFormat('US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: 0,
    maximumFractionDigits: 0
  }).format(extra);
}

const formatedPrice = formatPrice(listing.price);
const formatedExtra = formatExtra(listing.extra);

const {slug} = Astro.params;

---

<!-- CARD -->

<a href={`/${listing.slug}`} 
class="h-full rounded-2xl bg-primaryColor select-none text-terciaryColor flex flex-col justify-between duration-[0.15s] ease-in-out hover:outline hover:outline-2 hover:outline-secondaryColor"
data-type={listing.features_type}
data-beds={listing.features_bedrooms}
data-price={listing.price}
data-location={`${listing.location_country} ${listing.location_city} ${listing.location_state}`.toLowerCase()}
>
  <div>
    <div class="w-full h-48 rounded-t-2xl">
      <img
        src="https://mansionesmiami.com/wp-content/uploads/2020/05/620-Arvida-Pkwy-Coral-Gables-FL-33156-1.jpg"
        alt=""
        class="w-full h-full object-cover rounded-t-2xl"
        draggable="false"
      />
    </div>
    <div class="px-3 pt-3 pb-0">
      <!-- Price -->
      <div class="flex flex-row items-center justify-between">
        <div class="flex flex-col">
          <span class="font-secondaryFont text-2xl ">{formatedPrice}</span>
          <span class="font-secondaryFont text-md text-terciaryColor/75">{formatedExtra}</span>
        </div>

        <!-- Dynamic Status -->
        <span
        class:list={[
          "font-secondaryFont font-semibold bg-opacity-35 h-full text-sm px-3 py-1 w-24 rounded-2xl text-center text-nowrap mb-2",
          statusStyles[listing.status]
        ]}
      >
        {statusLabel[listing.status]}
      </span>
      </span>
    </div>

      <!-- Location -->
      <p class="font-secondaryFont mt-2 text-sm font-light leading-tight text-terciaryColor/75 flex">
        <img src="https://www.svgrepo.com/show/424575/location-direction-gps.svg" alt="Type Icon" class="mr-1 h-4 hidden" />
        {listing.location_address}, {listing.location_city}, {listing.location_state}, {listing.location_country}.
      </p>

    </div>
  </div>
  <div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-1 sm:gap-2 w-full px-3 py-3">
  
      <span class="flex justify-center flex-col">
        <img src="https://cdn-icons-png.flaticon.com/512/1946/1946488.png" width="20px" height="20px" alt="a" class=" m-auto h-4 w-4 mb-1">
        <p class="text-xs text-center justify-end w-full font-secondaryFont uppercase text-nowrap">{listing.features_type}</p>
      </span>
      <span class="flex justify-center flex-col">
        <img src="https://cdn-icons-png.flaticon.com/512/93/93640.png" alt="a" width="20px" height="20px" class=" m-auto h-4 w-4 mb-1">
        <p class="text-xs text-center justify-end w-full font-secondaryFont uppercase text-nowrap">{listing.features_area} m²</p>
      </span>
      <span class="flex justify-center flex-col">
        <img src="https://cdn-icons-png.flaticon.com/512/833/833593.png" width="20px" height="20px" alt="a" class=" m-auto h-4 w-4 mb-1">
        <p class="text-xs text-center justify-end w-full font-secondaryFont uppercase text-nowrap">BUILT IN {listing.features_year}</p>
      </span>

      <span class="flex justify-center flex-col">
        <img src="https://cdn-icons-png.flaticon.com/512/952/952772.png" width="20px" height="20px" alt="a" class=" m-auto h-4 w-4 mb-1">
        <p class="text-xs text-center justify-end w-full font-secondaryFont uppercase text-nowrap">{listing.features_bedrooms} BEDS</p>
      </span>
      <span class="flex justify-center flex-col">
        <img src="https://cdn-icons-png.flaticon.com/512/169/169301.png" width="20px" height="20px" alt="a" class=" m-auto h-4 w-4 mb-1">
        <p class="text-xs text-center justify-end w-full font-secondaryFont uppercase text-nowrap">{listing.features_bathrooms} BATHS</p>
      </span>
      <span class="flex justify-center flex-col">
        <img src="https://cdn-icons-png.flaticon.com/512/243/243232.png" width="20px" height="20px" alt="a" class=" m-auto h-4 w-4 mb-1">
        <p class="text-xs text-center justify-end w-full font-secondaryFont uppercase text-nowrap">{listing.features_slots} SLOTS</p>
      </span>

    </div>

    
  </div>


  <!-- AGENT/CY INFO -->
<div class="static bottom-0">

  <div class="p-1 m-0 border-t">
   <p class="text-xs text-center relative font-secondaryFont uppercase text-terciaryColor">{listing.agency}</p>
  </div>
  <div class="relative items-center border-t border-r-white p-3 grid grid-cols-2 justify-end">
    <div class="flex w-fit bottom-0">
      <!-- Agent Image -->
      <img
      src="https://placehold.co/100x100"
      alt="Agent Image"
      class="h-12 w-12 aspect-square rounded-xl object-cover"
      draggable="false"
      />
      
      <!-- Agent Details -->
      <div class="flex flex-col ml-2 w-full overflow-hidden">
          <p class="font-secondaryFont font-medium text-terciaryColor text-xs text-left my-2 truncate uppercase">
            {listing.agentName_1} <br> {listing.agentName_2}
          </p>
        </div>
    </div>

    <!-- Image Section -->
    <div class="absolute inset-y-0 right-0 overflow-hidden rounded-br-2xl w-[35%] sm:w-[50%] md:w-[50%]">
      <img
      src="https://placehold.co/1920x1080"
      alt="#"
      class="h-full object-cover w-full border-l"
      draggable="false"
      />

    </div>
  </div>

  </div>
</a>
