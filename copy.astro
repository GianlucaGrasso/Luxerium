      { title: "Miami", image: "https://images.unsplash.com/photo-1507679799987-c73779587ccf?q=80&w=2071&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" },
      { title: "Los Angeles", image: "https://images.unsplash.com/photo-1515895309288-a3815ab7cf81?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" },
      { title: "Chicago", image: "https://images.unsplash.com/photo-1513642623808-0770b0751d50?q=80&w=2069&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" },
      { title: "San Francisco", image: "https://images.unsplash.com/photo-1501594907352-04cda38ebc29?q=80&w=1932&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" }
    ]
  },
  vehicles: {
    title: "BRAND",
    items: [
      { title: "BMW", image: "https://images.unsplash.com/photo-1580273916550-e323be2ae537?q=80&w=1964&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" },
      { title: "Mercedes", image: "https://images.unsplash.com/photo-1617814076367-b759c7d7e738?q=80&w=1935&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" },
      { title: "Audi", image: "https://images.unsplash.com/photo-1588258219511-64eb629cb833?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" },
      { title: "Tesla", image: "https://images.unsplash.com/photo-1541899481282-d53bffe3c35d?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" },
      { title: "Porsche", image: "https://images.unsplash.com/photo-1503376780353-7e6692767b70?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" }
    ]
  },
  ships: {
    title: "TYPE",
    items: [
      { title: "Yacht", image: "https://www.charterworld.com/news/wp-content/uploads/2013/03/Mega-Yacht-Red-Square-by-Dunya-Yachts-Image-courtesy-of-Dunya-Yachts.jpg" },
      { title: "Sailboat", image: "https://images.unsplash.com/photo-1504851149312-7a075b496cc7?q=80&w=2069&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" },
      { title: "Catamaran", image: "https://images.unsplash.com/photo-1530014708988-0a2842d28b58?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" },
      { title: "Speedboat", image: "https://images.unsplash.com/photo-1598449356475-b9f71db7d847?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" },
      { title: "Cruise", image: "https://images.unsplash.com/photo-1599640842225-85d111c60e6b?q=80&w=1974&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" }
    ]
  },
  aircraft: {
    title: "MODEL",
    items: [
      { title: "Boeing 747", image: "https://images.unsplash.com/photo-1534447677768-be436bb09401?q=80&w=1794&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" },
      { title: "Airbus A380", image: "https://images.unsplash.com/photo-1557800578-33a6e1a0f0e1?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" },
      { title: "Cessna 172", image: "https://images.unsplash.com/photo-1587168957321-6d7c7c8c9a9f?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" },
      { title: "Gulfstream G650", image: "https://images.unsplash.com/photo-1606768666853-403c90a9819a?q=80&w=2071&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" },
      { title: "Embraer Phenom", image: "https://images.unsplash.com/photo-1610484640458-33f1d6c9d9d9?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" }
    ]
  }
};

// Categoría inicial
const initialCategory = "realestate";
---

<Layout title="TEST2">
  <div class="max-w-[100vw]">
    <!-- Selector de categorías -->
    <div class="flex flex-wrap justify-center gap-4 py-4">
      <button 
        class="category-btn px-4 py-2 bg-gray-200 rounded-md hover:bg-gray-300 transition-colors"
        data-category="realestate"
      >REAL ESTATE</button>
      <button 
        class="category-btn px-4 py-2 bg-gray-200 rounded-md hover:bg-gray-300 transition-colors"
        data-category="vehicles"
      >VEHICLES</button>
      <button 
        class="category-btn px-4 py-2 bg-gray-200 rounded-md hover:bg-gray-300 transition-colors"
        data-category="ships"
      >SHIPS</button>
      <button 
        class="category-btn px-4 py-2 bg-gray-200 rounded-md hover:bg-gray-300 transition-colors"
        data-category="aircraft"
      >AIRCRAFT</button>
    </div>
    
    <!-- Título dinámico -->
    <h1 id="category-title" class="text-center w-fit m-auto mt-[.75em] text-primaryColor font-secondaryFont text-[18px] pt-3">
      BROWSE BY {categories[initialCategory].title}
    </h1>
  
    <!-- Contenedor grid responsive -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 px-8 my-8">
      <!-- Elementos de Real Estate -->
      {categories.realestate.items.map((item, index) => (
        <div 
          class="browse-item category-realestate"
          data-category="realestate"
          class:list={[
            index === 0 ? "lg:col-span-2 lg:row-span-1" : "",
            index === 3 ? "lg:col-span-2 lg:row-span-1" : ""
          ]}
        >
          <BrowseBy title={item.title} image={item.image} />
        </div>
      ))}

      <!-- Elementos de Vehicles -->
      {categories.vehicles.items.map((item, index) => (
        <div 
          class="browse-item category-vehicles hidden"
          data-category="vehicles"
          class:list={[
            index === 0 ? "lg:col-span-2 lg:row-span-1" : "",
            index === 2 ? "lg:col-span-1 lg:row-span-2" : ""
          ]}
        >
          <BrowseBy title={item.title} image={item.image} />
        </div>
      ))}

      <!-- Elementos de Ships -->
      {categories.ships.items.map((item, index) => (
        <div 
          class="browse-item category-ships hidden"
          data-category="ships"
          class:list={[
            index === 1 ? "lg:col-span-2 lg:row-span-2" : "",
            index === 3 ? "lg:col-span-2 lg:row-span-1" : ""
          ]}
        >
          <BrowseBy title={item.title} image={item.image} />
        </div>
      ))}

      <!-- Elementos de Aircraft -->
      {categories.aircraft.items.map((item, index) => (
        <div 
          class="browse-item category-aircraft hidden"
          data-category="aircraft"
          class:list={[
            index === 0 ? "lg:col-span-3 lg:row-span-1" : "",
            index === 2 ? "lg:col-span-2 lg:row-span-2" : ""
          ]}
        >
          <BrowseBy title={item.title} image={item.image} />
        </div>
      ))}
    </div>
  </div>

  <!-- Script para cambiar categorías -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const categoryBtns = document.querySelectorAll('.category-btn');
      const categoryTitle = document.getElementById('category-title');
      
      categoryBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const category = btn.dataset.category;
          
          // Actualizar título
          const titles = {
            realestate: "LOCATION",
            vehicles: "BRAND",
            ships: "TYPE",
            aircraft: "MODEL"
          };
          categoryTitle.textContent = `BROWSE BY ${titles[category]}`;
          
          // Ocultar todos los elementos
          document.querySelectorAll('.browse-item').forEach(item => {
            item.classList.add('hidden');
          });
          
          // Mostrar elementos de la categoría seleccionada
          document.querySelectorAll(`.category-${category}`).forEach(item => {
            item.classList.remove('hidden');
          });
          
          // Actualizar botón activo
          categoryBtns.forEach(b => b.classList.remove('bg-primaryColor', 'text-white'));
          btn.classList.add('bg-primaryColor', 'text-white');
        });
      });
      
      // Activar botón inicial
      document.querySelector('[data-category="realestate"]').classList.add('bg-primaryColor', 'text-white');
    });
  </script>
  
  <!-- Estilos adicionales -->
  <style>
    .browse-item {
      transition: transform 0.3s ease, opacity 0.3s ease;
    }
    .browse-item:hover {
      transform: scale(1.02);
    }
  </style>
</Layout>